<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CityCrm.AdminUI</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        
        <AuthorizeView Roles="GrandAdmin, Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="registry">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Реєстр об'єктів
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="moderation">
                        <span class="bi bi-shield-check" aria-hidden="true" style="margin-right: 0.75rem; font-size: 1.25rem;"></span> Модерація бізнесу
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="GrandAdmin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="users">
                        <span class="bi bi-people-fill" aria-hidden="true" style="margin-right: 0.75rem; font-size: 1.25rem; display: inline-block;"></span> Користувачі
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="streets">
                <span class="bi bi-journal-text" aria-hidden="true"></span> Довідник вулиць
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="map">
                <span class="bi bi-geo-alt-fill" aria-hidden="true"></span> Карта об'єктів
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}