@page "/registry"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "GrandAdmin, Admin")]
@using CityCrm.AdminUI.Models
@using CityCrm.AdminUI.Components

<style>
    .expanded-row > td {
        background-color: #f8f9fa !important;
    }

    .expanded-row > td:first-child {
        box-shadow: inset 4px 0 0 0 #0d6efd;
    }

    @@keyframes flash-highlight {
        0% { background-color: #fff3cd !important; }
        100% { background-color: #f8f9fa !important; }
    }

    .highlighted-row > td {
        animation: flash-highlight 3s ease-out forwards;
    }
</style>

<PageTitle>Реєстр нерухомості</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Реєстр муніципальної нерухомості</h1>
    <AuthorizeView Roles="GrandAdmin, Admin">
        <Authorized>
            <button class="btn btn-success" @onclick="ShowAddBuildingModal">
                <i class="bi bi-plus-circle"></i> Додати будівлю
            </button>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card mb-3 shadow-sm border-0 bg-light">
    <div class="card-body p-3">
        <div class="d-flex gap-2 mb-2">
            <input type="text" class="form-control" placeholder="Пошук за вулицею, номером або приміткою..."
                   @bind="filterSearch" @bind:event="oninput" @onkeyup="HandleSearchEnter" />
            <button class="btn btn-primary px-4" @onclick="ApplyFilters"><i class="bi bi-search"></i> Знайти</button>
            <button class="btn btn-outline-secondary text-nowrap" @onclick="() => showAdvancedFilters = !showAdvancedFilters">
                <i class="bi bi-sliders"></i> @(showAdvancedFilters ? "Сховати фільтри" : "Розширений пошук")
            </button>
        </div>

        <div class="d-flex gap-2 align-items-center flex-wrap">
            <span class="text-muted small fw-bold me-2"><i class="bi bi-lightning-charge-fill text-warning"></i> Швидкі фільтри:</span>
            <button class="btn btn-sm btn-outline-success rounded-pill px-3" @onclick="@(() => ApplyQuickFilter("free_communal"))">Вільна комуналка</button>
            <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="@(() => ApplyQuickFilter("commerce"))">Комерційні площі</button>
            <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="@(() => ApplyQuickFilter("problems"))">Зруйновані / Аварійні</button>
            <button class="btn btn-sm btn-link text-decoration-none text-muted" @onclick="ResetFilters">Скинути всі</button>
        </div>

        @if (showAdvancedFilters)
        {
            <div class="row g-3 mt-2 pt-3 border-top border-secondary-subtle">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Тип забудови</label>
                    <select class="form-select form-select-sm" @bind="filterBType">
                        <option value="">Всі типи</option>
                        <option value="Багатоповерхівка">Багатоповерхівка</option>
                        <option value="Офісний/Бізнес центр">Офісний/Бізнес центр</option>
                        <option value="Гаражний кооператив">Гаражний кооператив</option>
                        <option value="Комерційна забудова">Комерційна забудова</option>
                        <option value="Гуртожиток">Гуртожиток</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Стан будівлі</label>
                    <select class="form-select form-select-sm" @bind="filterCondition">
                        <option value="">Будь-який</option>
                        <option value="В експлуатації">В експлуатації</option>
                        <option value="В процесі будівництва">В процесі будівництва</option>
                        <option value="Зруйновано (бойові дії)">Зруйновано</option>
                        <option value="Занедбана будівля">Занедбана</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Власність (Приміщення)</label>
                    <select class="form-select form-select-sm" @bind="filterPOwnership">
                        <option value="">Всі</option>
                        <option value="Комунальна">Комунальна</option>
                        <option value="Державна">Державна</option>
                        <option value="Приватна">Приватна</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Статус (Приміщення)</label>
                    <select class="form-select form-select-sm" @bind="filterPStatus">
                        <option value="">Всі</option>
                        <option value="Вільне">Вільне</option>
                        <option value="Орендоване (Комерція)">Орендоване (Комерція)</option>
                        <option value="Орендоване (Соціальне)">Орендоване (Соціальне)</option>
                        <option value="Службове">Службове</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Тип приміщення</label>
                    <select class="form-select form-select-sm" @bind="filterPType">
                        <option value="">Всі</option>
                        <option value="Житлова">Житлова</option>
                        <option value="Комерційна">Комерційна</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex gap-2">
                    <div class="flex-grow-1">
                        <label class="form-label small fw-bold text-muted mb-1">Площа від (м²)</label>
                        <input type="number" class="form-control form-select-sm" @bind="filterMinArea" />
                    </div>
                    <div class="flex-grow-1">
                        <label class="form-label small fw-bold text-muted mb-1">Площа до (м²)</label>
                        <input type="number" class="form-control form-select-sm" @bind="filterMaxArea" />
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width: 50px;"></th>
            <th>ID</th>
            <th>Адреса будівлі</th>
            <th>Тип забудови</th>
            <th>Стан</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @if (!buildings.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">Немає даних...</td></tr>
        }
        else
        {
            @foreach (var building in buildings)
            {
                <tr id="building-@building.Id" class="@(expandedBuildings.Contains(building.Id) ? "expanded-row" : "table-light") @(currentlyHighlightedId == building.Id ? "highlighted-row" : "")">
                    <td>
                        <button class="btn btn-sm @(expandedBuildings.Contains(building.Id) ? "btn-primary" : "btn-outline-secondary")"
                                @onclick="() => ToggleBuilding(building.Id)"
                                style="transition: all 0.2s ease;">
                            <i class="bi @(expandedBuildings.Contains(building.Id) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                        </button>
                    </td>
                    <td>@building.Id</td>
                    <td class="@(expandedBuildings.Contains(building.Id) ? "fw-bolder fs-6 text-primary" : "fw-bold")" style="transition: all 0.2s;">
                        @building.FullAddress
                        @if (!string.IsNullOrEmpty(building.Notes))
                        {
                            <div class="text-muted fw-normal mt-1" style="font-size: 0.8rem;">
                                <i class="bi bi-card-text"></i> @building.Notes
                            </div>
                        }
                    </td>
                    <td>@building.BuildingType</td>
                    <td>
                        <span class="badge @GetBuildingConditionBadge(building.Condition)">
                            @building.Condition
                        </span>
                    </td>
                    <td>
                        <AuthorizeView Roles="GrandAdmin, Admin">
                            <Authorized>
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditBuildingModal(building)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBuilding(building.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </Authorized>
                        </AuthorizeView>
                    </td>
                </tr>

                @if (expandedBuildings.Contains(building.Id))
                {
                    <tr>
                        <td></td>
                        <td colspan="5" class="p-0">
                            <div class="p-3 bg-white border-start border-3 border-primary shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0 text-primary">
                                        @(building.BuildingType == "Багатоповерхівка" || building.BuildingType == "Офісний/Бізнес центр" ? "Візуалізація під'їздів та поверхів:" : building.BuildingType == "Гаражний кооператив" ? "Схема гаражних рядів:" : "Приміщення у цій будівлі:")
                                    </h6>
                                    <AuthorizeView Roles="GrandAdmin, Admin">
                                        <Authorized>
                                            <button class="btn btn-sm btn-primary" @onclick="() => ShowAddPremiseModal(building.Id)">
                                                <i class="bi bi-plus"></i> Додати приміщення
                                            </button>
                                        </Authorized>
                                    </AuthorizeView>
                                </div>

                                @if (building.BuildingType == "Багатоповерхівка" || building.BuildingType == "Офісний/Бізнес центр")
                                {
                                    var entrances = building.Premises.Where(p => p.Entrance.HasValue).Select(p => p.Entrance.GetValueOrDefault()).Distinct().OrderBy(e => e).ToList();

                                    if (!entrances.Any())
                                    {
                                        <div class="alert alert-info">Додайте першу квартиру і вкажіть її під'їзд та поверх, щоб побачити сітку.</div>
                                    }
                                    else
                                    {
                                        int activeEntrance = selectedEntrances.ContainsKey(building.Id) ? selectedEntrances[building.Id] : entrances.First();

                                        <ul class="nav nav-tabs mb-3">
                                            @foreach (var ent in entrances)
                                            {
                                                <li class="nav-item">
                                                    <a class="nav-link @(activeEntrance == ent ? "active fw-bold" : "")"
                                                       style="cursor:pointer;"
                                                       @onclick="() => SelectEntrance(building.Id, ent)">Під'їзд @ent</a>
                                                </li>
                                            }
                                        </ul>

                                        var floors = building.Premises.Where(p => p.Entrance == activeEntrance && p.Floor.HasValue).Select(p => p.Floor.GetValueOrDefault()).Distinct().OrderByDescending(f => f);

                                        <div class="bg-light p-3 rounded border">
                                            @foreach (var floor in floors)
                                            {
                                                <div class="d-flex align-items-center mb-2 border-bottom pb-2">
                                                    <div class="me-3 text-muted fw-bold" style="width: 70px;">Пов. @floor</div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach (var premise in building.Premises.Where(p => p.Entrance == activeEntrance && p.Floor == floor).OrderBy(p => p.PremiseNumber))
                                                        {
                                                            <div class="card shadow-sm text-center text-white position-relative @GetPremiseColorClass(premise.Status)"
                                                                 style="width: 80px; cursor:pointer; transition: transform 0.2s;"
                                                                 @onclick="() => ShowEditPremiseModal(premise)"
                                                                 title="@premise.Type | @premise.Area кв.м | Власність: @premise.Ownership">
                                                                <div class="card-body p-2">
                                                                    @if (!string.IsNullOrEmpty(premise.Notes))
                                                                    {
                                                                        <div style="position: absolute; top: 2px; right: 4px; font-size: 0.6rem;" title="@premise.Notes">📝</div>
                                                                    }
                                                                    <div class="fw-bold fs-5">@premise.PremiseNumber</div>
                                                                    <div style="font-size: 0.65rem;" class="text-uppercase">@premise.Status</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }

                                    var noEntrancePremises = building.Premises.Where(p => !p.Entrance.HasValue).OrderBy(p => p.PremiseNumber).ToList();
                                    if (noEntrancePremises.Any())
                                    {
                                        <h6 class="mt-4 mb-3 text-secondary">Приміщення без прив'язки до під'їзду (Окремий вхід / Комерція):</h6>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var premise in noEntrancePremises)
                                            {
                                                <div class="card shadow-sm text-center text-white position-relative @GetPremiseColorClass(premise.Status)"
                                                     style="width: 80px; cursor:pointer; transition: transform 0.2s;"
                                                     @onclick="() => ShowEditPremiseModal(premise)"
                                                     title="@premise.Type | @premise.Area кв.м | Власність: @premise.Ownership">
                                                    <div class="card-body p-2">
                                                        @if (!string.IsNullOrEmpty(premise.Notes))
                                                        {
                                                            <div style="position: absolute; top: 2px; right: 4px; font-size: 0.6rem;" title="@premise.Notes">📝</div>
                                                        }
                                                        <div class="fw-bold fs-6">@premise.PremiseNumber</div>
                                                        <div style="font-size: 0.65rem;" class="text-uppercase">@premise.Status</div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (building.BuildingType == "Гаражний кооператив")
                                {
                                    var lines = building.Premises.Where(p => p.Entrance.HasValue).Select(p => p.Entrance.GetValueOrDefault()).Distinct().OrderBy(l => l).ToList();

                                    if (!lines.Any())
                                    {
                                        <div class="alert alert-info">Додайте перший гараж і вкажіть його лінію/ряд.</div>
                                    }
                                    else
                                    {
                                        <div class="bg-light p-3 rounded border">
                                            @foreach (var line in lines)
                                            {
                                                <h6 class="text-secondary border-bottom pb-1 mb-2">Лінія (Ряд) @line</h6>
                                                <div class="d-flex flex-wrap gap-2 mb-4">
                                                    @foreach (var premise in building.Premises.Where(p => p.Entrance == line).OrderBy(p => p.PremiseNumber))
                                                    {
                                                        <div class="card shadow-sm text-center text-white position-relative @GetPremiseColorClass(premise.Status)"
                                                             style="width: 80px; cursor:pointer; transition: transform 0.2s;"
                                                             @onclick="() => ShowEditPremiseModal(premise)"
                                                             title="@premise.Type | @premise.Area кв.м | Власність: @premise.Ownership">
                                                            <div class="card-body p-2">
                                                                @if (!string.IsNullOrEmpty(premise.Notes))
                                                                {
                                                                    <div style="position: absolute; top: 2px; right: 4px; font-size: 0.6rem;" title="@premise.Notes">📝</div>
                                                                }
                                                                <div class="fw-bold">№ @premise.PremiseNumber</div>
                                                                <div style="font-size: 0.65rem;" class="text-uppercase">@premise.Status</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr><th>№ / Назва</th><th>Площа</th><th>Тип</th><th>Статус</th><th>Дії</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var premise in building.Premises)
                                            {
                                                <tr>
                                                    <td>
                                                        @premise.PremiseNumber
                                                        @if (!string.IsNullOrEmpty(premise.Notes))
                                                        {
                                                            <span class="ms-1" title="@premise.Notes">📝</span>
                                                        }
                                                    </td>
                                                    <td>@premise.Area кв.м</td>
                                                    <td>@premise.Type</td>
                                                    <td><span class="badge bg-secondary">@premise.Status</span></td>
                                                    <td>
                                                        <AuthorizeView Roles="GrandAdmin, Admin">
                                                            <Authorized>
                                                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditPremiseModal(premise)"><i class="bi bi-pencil"></i></button>
                                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePremise(premise.Id)"><i class="bi bi-trash"></i></button>
                                                            </Authorized>
                                                        </AuthorizeView>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>

<BuildingModal IsVisible="showBuildingModal"
               Model="newBuilding"
               OtherBuildings="buildings"
               OnSaved="HandleBuildingSaved"
               OnClosed="CloseBuildingModal" />

<PremiseModal IsVisible="showPremiseModal"
              Model="newPremise"
              BuildingType="@(buildings.FirstOrDefault(b => b.Id == newPremise.BuildingId)?.BuildingType ?? "")"
              ExistingPremises="@(buildings.FirstOrDefault(b => b.Id == newPremise.BuildingId)?.Premises ?? new List<Premise>())"
              OnSaved="HandlePremiseSaved"
              OnClosed="ClosePremiseModal" />