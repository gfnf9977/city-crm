    private void ShowEditPremiseModal(Premise p)
    {
        errorMessage = "";
        newPremise = new Premise { Id = p.Id, BuildingId = p.BuildingId, PremiseNumber = p.PremiseNumber, Entrance = p.Entrance, Floor = p.Floor, Area = p.Area, Type = p.Type, Status = p.Status, Ownership = p.Ownership, OwnerName = p.OwnerName, RegistrationDate = p.RegistrationDate, RentEndDate = p.RentEndDate, Notes = p.Notes };
        showPremiseModal = true;
    }

    private void ClosePremiseModal() => showPremiseModal = false;

    private async Task SavePremise()
    {
        errorMessage = "";

        var currentBuilding = buildings.FirstOrDefault(b => b.Id == newPremise.BuildingId);
        if (currentBuilding != null && !string.IsNullOrWhiteSpace(newPremise.PremiseNumber))
        {
            bool isDuplicate = currentBuilding.Premises.Any(p =>
                p.Id != newPremise.Id &&
                p.PremiseNumber.Trim().ToLower() == newPremise.PremiseNumber.Trim().ToLower());

            if (isDuplicate)
            {
                errorMessage = $"Увага! Приміщення з номером {newPremise.PremiseNumber} вже існує у цій будівлі.";
                return;
            }
        }

        if (newPremise.Ownership == "Приватна" || newPremise.Ownership == "Державна")
        {
            if (newPremise.Status != "В експлуатації" && newPremise.Status != "Аварійне")
            {
                errorMessage = $"Помилка сумісності! Система не веде облік оренди чи службового використання для форми власності '{newPremise.Ownership}'. Оберіть статус 'В експлуатації' або 'Аварійне'. Будь ласка, переконайтеся у правильності даних.";
                return;
            }
        }
        else if (newPremise.Ownership == "Комунальна")
        {
            if (newPremise.Status == "В експлуатації")
            {
                errorMessage = "Помилка сумісності! Статус 'В експлуатації' використовується для приватних або державних об'єктів. Для комунальної власності деталізуйте статус (напр. 'Вільне', 'Службове' або 'Орендоване').";
                return;
            }

            if (newPremise.Type == "Житлова" && newPremise.Status == "Орендоване (Комерція)")
            {
                errorMessage = "Помилка сумісності! Житлове комунальне приміщення не може здаватися в комерційну оренду. Якщо це програма муніципального житла, оберіть 'Орендоване (Соціальне)'. Переконайтеся у правильності даних.";
                return;
            }

            if (newPremise.Type == "Комерційна" && newPremise.Status == "Орендоване (Соціальне)")
            {
                errorMessage = "Помилка сумісності! Комерційне приміщення не підпадає під програму соціального муніципального житла. Оберіть 'Орендоване (Комерція)'. Переконайтеся у правильності даних.";
                return;
            }
        }

        var response = newPremise.Id == 0
            ? await Http.PostAsJsonAsync("api/premises", newPremise)
            : await Http.PutAsJsonAsync($"api/premises/{newPremise.Id}", newPremise);

        if (response.IsSuccessStatusCode)
        {
            await LoadBuildings();
            showPremiseModal = false;
        }
        else
        {
            errorMessage = "Сервер відхилив запит. Перевірте дані.";
        }
    }

    private async Task DeletePremise(int id)
    {
        var response = await Http.DeleteAsync($"api/premises/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadBuildings();
            showPremiseModal = false;
        }
    }

    private string GetPremiseColorClass(string status) => status switch
    {
        "Вільне" => "bg-success border-success",
        "Аварійне" => "bg-danger border-danger",
        "Орендоване (Комерція)" => "bg-primary border-primary",
        "Орендоване (Соціальне)" => "bg-info border-info text-dark",
        "Службове" => "bg-warning border-warning text-dark",
        _ => "bg-secondary border-secondary"
    };

    private string GetBuildingConditionBadge(string condition) => condition switch
    {
        "В експлуатації" => "bg-success",
        "В процесі будівництва" => "bg-warning text-dark",
        "Зруйновано (бойові дії)" => "bg-danger",
        "Занедбана будівля" => "bg-secondary",
        _ => "bg-light text-dark"
    };
