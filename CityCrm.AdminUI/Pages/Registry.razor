@page "/registry"
@using CityCrm.AdminUI.Models
@inject HttpClient Http
@inject IJSRuntime JS

<style>
    @@keyframes flash-highlight {
        0% { background-color: #fff3cd !important; }
        100% { background-color: inherit; }
    }
    .highlighted-row {
        animation: flash-highlight 3s ease-out forwards;
    }
</style>

<PageTitle>Реєстр нерухомості</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Реєстр муніципальної нерухомості</h1>
    <button class="btn btn-success" @onclick="ShowAddBuildingModal">
        <i class="bi bi-plus-circle"></i> Додати будівлю
    </button>
</div>

<table class="table table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width: 50px;"></th>
            <th>ID</th>
            <th>Адреса будівлі</th>
            <th>Тип забудови</th>
            <th>Стан</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @if (!buildings.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">Немає даних...</td></tr>
        }
        else
        {
            @foreach (var building in buildings)
            {
                <tr id="building-@building.Id" class="table-light @(currentlyHighlightedId == building.Id ? "highlighted-row" : "")">
                    <td>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ToggleBuilding(building.Id)">
                            <i class="bi @(expandedBuildings.Contains(building.Id) ? "bi-chevron-up" : "bi-chevron-down")"></i>
                        </button>
                    </td>
                    <td>@building.Id</td>
                    <td class="fw-bold">
                        @building.FullAddress
                        @if (!string.IsNullOrEmpty(building.Notes))
                        {
                            <div class="text-muted fw-normal mt-1" style="font-size: 0.8rem;">
                                <i class="bi bi-card-text"></i> @building.Notes
                            </div>
                        }
                    </td>
                    <td>@building.BuildingType</td>
                    <td>
                        <span class="badge @GetBuildingConditionBadge(building.Condition)">
                            @building.Condition
                        </span>
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditBuildingModal(building)">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBuilding(building.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>

                @if (expandedBuildings.Contains(building.Id))
                {
                    <tr>
                        <td></td>
                        <td colspan="5" class="p-0">
                            <div class="p-3 bg-white border-start border-3 border-primary shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0 text-primary">
                                        @(building.BuildingType == "Багатоповерхівка" || building.BuildingType == "Офісний/Бізнес центр" ? "Візуалізація під'їздів та поверхів:" : building.BuildingType == "Гаражний кооператив" ? "Схема гаражних рядів:" : "Приміщення у цій будівлі:")
                                    </h6>
                                    <button class="btn btn-sm btn-primary" @onclick="() => ShowAddPremiseModal(building.Id)">
                                        <i class="bi bi-plus"></i> Додати приміщення
                                    </button>
                                </div>

                                @if (building.BuildingType == "Багатоповерхівка" || building.BuildingType == "Офісний/Бізнес центр")
                                {
                                    var entrances = building.Premises.Where(p => p.Entrance.HasValue).Select(p => p.Entrance.GetValueOrDefault()).Distinct().OrderBy(e => e).ToList();

                                    if (!entrances.Any())
                                    {
                                        <div class="alert alert-info">Додайте першу квартиру і вкажіть її під'їзд та поверх, щоб побачити сітку.</div>
                                    }
                                    else
                                    {
                                        int activeEntrance = selectedEntrances.ContainsKey(building.Id) ? selectedEntrances[building.Id] : entrances.First();

                                        <ul class="nav nav-tabs mb-3">
                                            @foreach (var ent in entrances)
                                            {
                                                <li class="nav-item">
                                                    <a class="nav-link @(activeEntrance == ent ? "active fw-bold" : "")"
                                                       style="cursor:pointer;"
                                                       @onclick="() => SelectEntrance(building.Id, ent)">Під'їзд @ent</a>
                                                </li>
                                            }
                                        </ul>

                                        var floors = building.Premises.Where(p => p.Entrance == activeEntrance && p.Floor.HasValue).Select(p => p.Floor.GetValueOrDefault()).Distinct().OrderByDescending(f => f);

                                        <div class="bg-light p-3 rounded border">
                                            @foreach (var floor in floors)
                                            {
                                                <div class="d-flex align-items-center mb-2 border-bottom pb-2">
                                                    <div class="me-3 text-muted fw-bold" style="width: 70px;">Пов. @floor</div>
                                                    <div class="d-flex flex-wrap gap-2">
                                                        @foreach(var premise in building.Premises.Where(p => p.Entrance == activeEntrance && p.Floor == floor).OrderBy(p => p.PremiseNumber))
                                                        {
                                                            <div class="card shadow-sm text-center text-white position-relative @GetPremiseColorClass(premise.Status)"
                                                                 style="width: 80px; cursor:pointer; transition: transform 0.2s;"
                                                                 @onclick="() => ShowEditPremiseModal(premise)"
                                                                 title="@premise.Type | @premise.Area кв.м | Власність: @premise.Ownership">
                                                                <div class="card-body p-2">
                                                                    @if (!string.IsNullOrEmpty(premise.Notes))
                                                                    {
                                                                        <div style="position: absolute; top: 2px; right: 4px; font-size: 0.6rem;" title="@premise.Notes">📝</div>
                                                                    }
                                                                    <div class="fw-bold fs-5">@premise.PremiseNumber</div>
                                                                    <div style="font-size: 0.65rem;" class="text-uppercase">@premise.Status</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (building.BuildingType == "Гаражний кооператив")
                                {
                                    var lines = building.Premises.Where(p => p.Entrance.HasValue).Select(p => p.Entrance.GetValueOrDefault()).Distinct().OrderBy(l => l).ToList();

                                    if (!lines.Any())
                                    {
                                        <div class="alert alert-info">Додайте перший гараж і вкажіть його лінію/ряд.</div>
                                    }
                                    else
                                    {
                                        <div class="bg-light p-3 rounded border">
                                            @foreach (var line in lines)
                                            {
                                                <h6 class="text-secondary border-bottom pb-1 mb-2">Лінія (Ряд) @line</h6>
                                                <div class="d-flex flex-wrap gap-2 mb-4">
                                                    @foreach(var premise in building.Premises.Where(p => p.Entrance == line).OrderBy(p => p.PremiseNumber))
                                                    {
                                                        <div class="card shadow-sm text-center text-white position-relative @GetPremiseColorClass(premise.Status)"
                                                             style="width: 80px; cursor:pointer; transition: transform 0.2s;"
                                                             @onclick="() => ShowEditPremiseModal(premise)"
                                                             title="@premise.Type | @premise.Area кв.м | Власність: @premise.Ownership">
                                                            <div class="card-body p-2">
                                                                @if (!string.IsNullOrEmpty(premise.Notes))
                                                                {
                                                                    <div style="position: absolute; top: 2px; right: 4px; font-size: 0.6rem;" title="@premise.Notes">📝</div>
                                                                }
                                                                <div class="fw-bold">№ @premise.PremiseNumber</div>
                                                                <div style="font-size: 0.65rem;" class="text-uppercase">@premise.Status</div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-light">
                                            <tr><th>№ / Назва</th><th>Площа</th><th>Тип</th><th>Статус</th><th>Дії</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var premise in building.Premises)
                                            {
                                                <tr>
                                                    <td>
                                                        @premise.PremiseNumber
                                                        @if (!string.IsNullOrEmpty(premise.Notes))
                                                        {
                                                            <span class="ms-1" title="@premise.Notes">📝</span>
                                                        }
                                                    </td>
                                                    <td>@premise.Area кв.м</td>
                                                    <td>@premise.Type</td>
                                                    <td><span class="badge bg-secondary">@premise.Status</span></td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditPremiseModal(premise)"><i class="bi bi-pencil"></i></button>
                                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePremise(premise.Id)"><i class="bi bi-trash"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>

@if (showBuildingModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Будівля</h5>
                    <button type="button" class="btn-close" @onclick="CloseBuildingModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="newBuilding" OnSubmit="SaveBuilding">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />
                        <div class="mb-3">
                            <label class="fw-bold">Тип забудови</label>
                            <InputSelect class="form-select" @bind-Value="newBuilding.BuildingType">
                                <option value="Багатоповерхівка">Багатоповерхівка (Житлова)</option>
                                <option value="Офісний/Бізнес центр">Офісний/Бізнес центр</option>
                                <option value="Громадська будівля">Громадська будівля (Школа, Лікарня)</option>
                                <option value="Приватний будинок">Приватний будинок</option>
                                <option value="Комерційна забудова">Комерційна забудова (Готель / Офіс / ТЦ)</option>
                                <option value="Промисловий/Складський об'єкт">Промисловий/Складський об'єкт</option>
                                <option value="Гаражний кооператив">Гаражний кооператив</option>
                                <option value="Гуртожиток">Гуртожиток</option>
                            </InputSelect>
                        </div>

                        <div class="card p-3 mb-3 bg-light border-0 shadow-sm">
                            @if (newBuilding.BuildingType == "Гаражний кооператив")
                            {
                                <div class="mb-3">
                                    <label class="fw-bold text-primary">Номер кооперативу (АК №)</label>
                                    <InputText class="form-control border-primary" @bind-Value="newBuilding.CoopNumber" placeholder="Наприклад: 27" />
                                </div>
                            }

                            <div class="mb-3 position-relative">
                                <label class="fw-bold">Вулиця</label>
                                <input type="text" class="form-control"
                                       @bind="streetSearchQuery"
                                       @oninput="SearchStreet"
                                       placeholder="Почніть вводити назву (напр. Рокос...)"
                                       autocomplete="off" />

                                @if (streetSuggestions.Any())
                                {
                                    <ul class="list-group position-absolute w-100 shadow-lg mt-1" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                                        @foreach(var s in streetSuggestions)
                                        {
                                            <li class="list-group-item list-group-item-action text-primary"
                                                style="cursor: pointer;"
                                                @onclick="() => SelectStreet(s)">
                                                <i class="bi bi-geo-alt me-2"></i> @s.DisplayName
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (!string.IsNullOrEmpty(newBuilding.StreetName))
                                {
                                    <div class="form-text text-success">
                                        <i class="bi bi-check-circle"></i> Обрано: @newBuilding.StreetType @newBuilding.StreetName
                                    </div>
                                }
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <label>Номер будинку / об'єкту</label>
                                    <div class="input-group mb-1">
                                        <InputNumber class="form-control" style="max-width: 120px;" @bind-Value="newBuilding.BuildingNumber" placeholder="15" />
                                        <span class="input-group-text">-</span>
                                        <InputText class="form-control" style="max-width: 100px;" @bind-Value="newBuilding.BuildingLetter" placeholder="А" />

                                        <button type="button" class="btn btn-outline-primary fw-bold" @onclick="FetchOsmContour" disabled="@isFetchingOsm">
                                            @if(isFetchingOsm) { <span class="spinner-border spinner-border-sm"></span> }
                                            else { <span>🪄 Знайти контур</span> }
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(osmMessage))
                                    {
                                        <small class="text-info fw-bold">@osmMessage</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label>Технічний стан</label>
                            <InputSelect class="form-select" @bind-Value="newBuilding.Condition">
                                <option value="В експлуатації">В експлуатації (Нормальний)</option>
                                <option value="В процесі будівництва">В процесі будівництва</option>
                                <option value="Зруйновано (бойові дії)">Зруйновано (бойові дії)</option>
                                <option value="Занедбана будівля">Занедбана будівля (Покинуто)</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Примітки (опціонально)</label>
                            <InputTextArea class="form-control" @bind-Value="newBuilding.Notes" rows="2" placeholder="Особливості об'єкта, пошкодження тощо..." />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Клікніть на карті, щоб вказати розташування:</label>
                            <div id="mapPicker" style="height: 450px; width: 100%; border-radius: 8px; border: 1px solid #ccc; z-index: 1000;"></div>

                            @if (newBuilding.Lat != 0)
                            {
                                <small class="text-success"><i class="bi bi-geo-alt-fill"></i> Точку зафіксовано: @newBuilding.Lat, @newBuilding.Lng</small>
                            }
                            else
                            {
                                <small class="text-danger"><i class="bi bi-exclamation-triangle"></i> Розташування не обрано!</small>
                            }
                        </div>

                        <div class="text-end">
                            <button type="button" class="btn btn-secondary" @onclick="CloseBuildingModal">Скасувати</button>
                            <button type="submit" class="btn btn-primary">Зберегти</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (showPremiseModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(newPremise.Id == 0 ? "Додати приміщення" : "Редагувати приміщення")</h5>
                    <button type="button" class="btn-close" @onclick="ClosePremiseModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger p-2 mb-3">@errorMessage</div>
                    }

                    <EditForm Model="newPremise" OnSubmit="SavePremise">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />
                        <div class="mb-3"><label>№ приміщення (квартири/кімнати/офісу)</label><InputText class="form-control" @bind-Value="newPremise.PremiseNumber" required /></div>

                        @{
                            var bType = buildings.FirstOrDefault(b => b.Id == newPremise.BuildingId)?.BuildingType;
                        }

                        <div class="row">
                            @if (bType == "Гаражний кооператив")
                            {
                                <div class="col-md-12 mb-3">
                                    <label>Ряд / Лінія (Тільки цифра)</label>
                                    <InputNumber class="form-control" @bind-Value="newPremise.Entrance" />
                                </div>
                            }
                            else if (bType == "Багатоповерхівка" || bType == "Офісний/Бізнес центр" || bType == "Гуртожиток")
                            {
                                <div class="col-md-6 mb-3">
                                    <label>Під'їзд / Блок / Секція</label>
                                    <InputNumber class="form-control" @bind-Value="newPremise.Entrance" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label>Поверх</label>
                                    <InputNumber class="form-control" @bind-Value="newPremise.Floor" />
                                </div>
                            }
                        </div>

                        <div class="mb-3"><label>Площа (кв.м)</label><InputNumber class="form-control" @bind-Value="newPremise.Area" required /></div>
                        <div class="mb-3">
                            <label>Тип</label>
                            <InputSelect class="form-select" @bind-Value="newPremise.Type">
                                <option value="Житлова">Житлова</option>
                                <option value="Комерційна">Комерційна</option>
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Статус</label>
                            <InputSelect class="form-select" @bind-Value="newPremise.Status">
                                <option value="Вільне">Вільне (очікує аукціону/розподілу)</option>
                                <option value="Орендоване (Комерція)">Орендоване (Комерція)</option>
                                <option value="Орендоване (Соціальне)">Орендоване (Муніципальне житло)</option>
                                <option value="Службове">Службове (ЦНАП, ЖЕК, Інше)</option>
                                <option value="В експлуатації">В експлуатації (Приватне / Державне)</option>
                                <option value="Аварійне">Аварійне</option>
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label>Власність</label>
                            <InputSelect class="form-select" @bind-Value="newPremise.Ownership">
                                <option value="Комунальна">Комунальна (Місто)</option>
                                <option value="Приватна">Приватна</option>
                                <option value="Державна">Державна</option>
                            </InputSelect>
                        </div>

                        @if (newPremise.Ownership == "Приватна" || newPremise.Ownership == "Державна")
                        {
                            <div class="card card-body bg-light border-secondary mb-3 shadow-sm p-3">
                                <h6 class="text-secondary border-bottom pb-2">Дані з реєстру прав:</h6>
                                <div class="mb-2">
                                    <label>Власник (ПІБ або Назва установи)</label>
                                    <InputText class="form-control" @bind-Value="newPremise.OwnerName" />
                                </div>
                                <div>
                                    <label>Дата реєстрації права власності</label>
                                    <InputDate class="form-control" @bind-Value="newPremise.RegistrationDate" />
                                </div>
                            </div>
                        }
                        else if (newPremise.Ownership == "Комунальна" && (newPremise.Status == "Орендоване (Комерція)" || newPremise.Status == "Орендоване (Соціальне)"))
                        {
                            <div class="card card-body bg-light border-primary mb-3 shadow-sm p-3">
                                <h6 class="text-primary border-bottom pb-2">
                                    Дані оренди (@(newPremise.Status == "Орендоване (Комерція)" ? "Комерційної" : "Соціальної")):
                                </h6>
                                <div class="mb-2">
                                    <label>Орендар (@(newPremise.Status == "Орендоване (Комерція)" ? "Назва компанії / ФОП" : "ПІБ особи / родини"))</label>
                                    <InputText class="form-control" @bind-Value="newPremise.OwnerName" />
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <label>Початок договору</label>
                                        <InputDate class="form-control" @bind-Value="newPremise.RegistrationDate" />
                                    </div>
                                    <div class="col-6">
                                        <label>Кінець договору</label>
                                        <InputDate class="form-control" @bind-Value="newPremise.RentEndDate" />
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="mb-3">
                            <label>Примітки (опціонально)</label>
                            <InputTextArea class="form-control" @bind-Value="newPremise.Notes" rows="2" placeholder="Стан ремонту, особливості оренди..." />
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <div>
                                @if (newPremise.Id > 0)
                                {
                                    <button type="button" class="btn btn-outline-danger" @onclick="() => DeletePremise(newPremise.Id)">Видалити</button>
                                }
                            </div>
                            <div>
                                <button type="button" class="btn btn-secondary me-2" @onclick="ClosePremiseModal">Скасувати</button>
                                <button type="submit" class="btn btn-primary">Зберегти</button>
                            </div>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private class CoordinatesDto { public double Lat { get; set; } public double Lng { get; set; } }

    private List<Building> buildings = new();
    private HashSet<int> expandedBuildings = new();
    private Dictionary<int, int> selectedEntrances = new();

    private bool showBuildingModal = false;
    private bool showPremiseModal = false;
    private Building newBuilding = new();
    private Premise newPremise = new();
    private string errorMessage = "";

    private string streetSearchQuery = "";
    private List<Street> streetSuggestions = new();

    private DotNetObjectReference<Registry>? objRef;

    private bool isFetchingOsm = false;
    private string osmMessage = "";
    private string? currentGeoJson = null;

    [SupplyParameterFromQuery(Name = "highlight")]
    public int? HighlightBuildingId { get; set; }

    private int? currentlyHighlightedId = null;

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnInitializedAsync() => await LoadBuildings();

    [JSInvokable]
    public void SetPickedCoordinates(double lat, double lng)
    {
        newBuilding.Lat = lat;
        newBuilding.Lng = lng;
        newBuilding.GeoJson = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void SetDrawnGeoJson(string? geoJsonStr)
    {
        newBuilding.GeoJson = geoJsonStr;

        newBuilding.Lat = 0;
        newBuilding.Lng = 0;

        StateHasChanged();
    }

    private async Task LoadBuildings()
    {
        var result = await Http.GetFromJsonAsync<List<Building>>("api/buildings");
        if (result != null) 
        {
            buildings = result;

            if (HighlightBuildingId.HasValue)
            {
                expandedBuildings.Clear(); 
                expandedBuildings.Add(HighlightBuildingId.Value); 
                currentlyHighlightedId = HighlightBuildingId.Value; 

                StateHasChanged(); 

                await Task.Delay(100); 
                await JS.InvokeVoidAsync("scrollToElement", $"building-{currentlyHighlightedId}");

                _ = Task.Run(async () =>
                {
                    await Task.Delay(3500); 
                    currentlyHighlightedId = null;
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
    }

    private void ToggleBuilding(int id)
    {
        if (expandedBuildings.Contains(id)) expandedBuildings.Remove(id);
        else expandedBuildings.Add(id);
    }

    private void SelectEntrance(int buildingId, int entrance)
    {
        selectedEntrances[buildingId] = entrance;
    }

    private async Task SearchStreet(ChangeEventArgs e)
    {
        streetSearchQuery = e.Value?.ToString() ?? "";

        if (streetSearchQuery.Length >= 2)
        {
            var result = await Http.GetFromJsonAsync<List<Street>>($"api/streets/search?q={streetSearchQuery}");
            if (result != null) streetSuggestions = result;
        }
        else
        {
            streetSuggestions.Clear();
        }
    }

    private void SelectStreet(Street street)
    {
        newBuilding.StreetType = street.StreetType;
        newBuilding.StreetName = street.Name;

        streetSearchQuery = street.DisplayName;
        streetSuggestions.Clear();
    }

    private async Task FetchOsmContour()
    {
        if (string.IsNullOrWhiteSpace(newBuilding.StreetName) || newBuilding.BuildingNumber <= 0)
        {
            osmMessage = "Спочатку оберіть вулицю та вкажіть коректний номер будинку!";
            return;
        }

        isFetchingOsm = true;
        osmMessage = "📡 Шукаємо контур будівлі в OSM...";
        StateHasChanged();

        bool contourFound = false;

        string fullNumber = $"{newBuilding.BuildingNumber}{newBuilding.BuildingLetter?.Trim()}";

        try
        {
            var response = await Http.GetAsync($"api/buildings/osm-contour?street={newBuilding.StreetName}&number={Uri.EscapeDataString(fullNumber)}");

            if (response.IsSuccessStatusCode)
            {
                currentGeoJson = await response.Content.ReadAsStringAsync();
                newBuilding.GeoJson = currentGeoJson;
                newBuilding.Lat = 0; newBuilding.Lng = 0;
                osmMessage = "✨ Контур знайдено і побудовано!";
                await JS.InvokeVoidAsync("drawOsmPolygon", currentGeoJson);
                contourFound = true;
            }
        }
        catch { }

        if (!contourFound)
        {
            osmMessage = "🔍 Контур не знайдено. Шукаємо координати будинку...";
            StateHasChanged();

            try
            {
                var geoResponse = await Http.GetAsync($"api/streets/geocode?street={newBuilding.StreetName}&number={Uri.EscapeDataString(fullNumber)}");
                if (geoResponse.IsSuccessStatusCode)
                {
                    var coords = await geoResponse.Content.ReadFromJsonAsync<CoordinatesDto>();
                    if (coords != null)
                    {
                        await JS.InvokeVoidAsync("centerMapPicker", coords.Lat, coords.Lng);
                        osmMessage = "📍 Контур відсутній, але ми відцентрували карту на цій адресі. Намалюйте об'єкт вручну (кнопка ⬟).";
                    }
                }
                else
                {
                    osmMessage = "❌ Будівлю не знайдено взагалі. Знайдіть її на карті та намалюйте контур вручну (кнопка ⬟).";
                }
            }
            catch
            {
                osmMessage = "❌ Будівлю не знайдено. Намалюйте контур вручну (кнопка ⬟).";
            }
        }

        isFetchingOsm = false;
        StateHasChanged();
    }

    private async Task ShowAddBuildingModal()
    {
        newBuilding = new Building { BuildingType = "Багатоповерхівка", Condition = "В експлуатації", StreetType = "вул." };
        streetSearchQuery = "";
        streetSuggestions.Clear();
        osmMessage = "";
        currentGeoJson = null;
        showBuildingModal = true;

        await Task.Delay(100);
        var otherPolygons = buildings.Where(b => !string.IsNullOrEmpty(b.GeoJson)).Select(b => b.GeoJson).ToList();
        await JS.InvokeVoidAsync("initMapPicker", 0, 0, objRef, otherPolygons);
    }

    private async Task ShowEditBuildingModal(Building b)
    {
        newBuilding = new Building {
            Id = b.Id, BuildingType = b.BuildingType, Condition = b.Condition,
            Lat = b.Lat, Lng = b.Lng,
            StreetType = b.StreetType, StreetName = b.StreetName,
            BuildingNumber = b.BuildingNumber,
            BuildingLetter = b.BuildingLetter,
            CoopNumber = b.CoopNumber,
            GeoJson = b.GeoJson,
            Notes = b.Notes
        };

        streetSearchQuery = $"{b.StreetType} {b.StreetName}";
        streetSuggestions.Clear();
        osmMessage = "";
        currentGeoJson = null;
        showBuildingModal = true;

        await Task.Delay(100);

        var otherPolygons = buildings.Where(x => x.Id != b.Id && !string.IsNullOrEmpty(x.GeoJson)).Select(x => x.GeoJson).ToList();
        await JS.InvokeVoidAsync("initMapPicker", b.Lat, b.Lng, objRef, otherPolygons);

        if (!string.IsNullOrEmpty(b.GeoJson))
        {
            await JS.InvokeVoidAsync("drawOsmPolygon", b.GeoJson);
        }
    }

    private void CloseBuildingModal() => showBuildingModal = false;

    private async Task SaveBuilding()
    {
        if (!string.IsNullOrWhiteSpace(newBuilding.BuildingLetter))
        {
            string letter = newBuilding.BuildingLetter.Trim().ToUpper();
            letter = letter.TrimStart('-', ' ');
            letter = letter.Replace("A", "А").Replace("B", "В").Replace("C", "С")
                           .Replace("E", "Е").Replace("H", "Н").Replace("I", "І")
                           .Replace("M", "М").Replace("O", "О").Replace("P", "Р")
                           .Replace("T", "Т").Replace("X", "Х");
            newBuilding.BuildingLetter = letter;
        }

        if (newBuilding.Lat == 0 && string.IsNullOrEmpty(newBuilding.GeoJson))
        {
            osmMessage = "❌ Помилка: Оберіть розташування на карті (клікніть або знайдіть контур)!";
            return;
        }

        var response = newBuilding.Id == 0
            ? await Http.PostAsJsonAsync("api/buildings", newBuilding)
            : await Http.PutAsJsonAsync($"api/buildings/{newBuilding.Id}", newBuilding);

        if (response.IsSuccessStatusCode) { await LoadBuildings(); showBuildingModal = false; }
    }

    private async Task DeleteBuilding(int id) { if ((await Http.DeleteAsync($"api/buildings/{id}")).IsSuccessStatusCode) await LoadBuildings(); }

