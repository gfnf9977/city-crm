@page "/city-issues"
@using CityCrm.AdminUI.Models
@inject HttpClient Http

<PageTitle>Благоустрій | CityCrm</PageTitle>

<div class="container py-4" style="max-width: 850px;">
    <h2 class="fw-bold text-dark mb-3"><i class="bi bi-cone-striped text-danger"></i> Фіксація проблем міста</h2>
    <p class="text-muted mb-4">
        Помітили відкритий люк, зламану лавку чи невимкнене освітлення вдень? Повідомте про це, і ми передамо заявку відповідальним службам.
    </p>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color: #f8f9fa;">
                <div class="card-body text-center p-4 d-flex flex-column justify-content-center">
                    <i class="bi bi-geo-alt-fill text-danger display-4 mb-3"></i>
                    <h5 class="fw-bold">Повідомити про нову проблему</h5>
                    <p class="text-muted small mb-4">Перейдіть на карту, натисніть "Повідомити про проблему" та клікніть на місце інциденту.</p>
                    <a href="map" class="btn btn-danger rounded-pill px-4 mt-auto shadow-sm">Відкрити карту</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-search text-primary"></i> Перевірити статус</h5>
                    <p class="text-muted small">Введіть номер заявки (напр. INC-2609-1234), щоб дізнатися її стан.</p>
                    
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="INC-..." @bind="trackingId" @bind:event="oninput" @onkeyup="HandleTrackingEnter" />
                        <button class="btn btn-primary" @onclick="CheckStatus" disabled="@isChecking">
                            @if (isChecking) { <span class="spinner-border spinner-border-sm"></span> }
                            else { <span>Перевірити</span> }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (trackingResult != null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                    <h5 class="fw-bold mb-0">Заявка #@trackingResult.TrackingNumber</h5>
                    <span class="badge @GetStatusAlertClass(trackingResult.Status) fs-6">
                        <i class="bi @GetStatusIconClass(trackingResult.Status)"></i> @GetStatusText(trackingResult.Status)
                    </span>
                </div>
                
                <div class="mb-3">
                    <h6 class="text-muted mb-1 small">Категорія</h6>
                    <p class="fw-bold mb-2">@trackingResult.Category</p>
                    <h6 class="text-muted mb-1 small">Ваш опис</h6>
                    <p class="fst-italic mb-0 border-start border-3 border-secondary ps-2">@trackingResult.Description</p>
                </div>

                @if (!string.IsNullOrEmpty(trackingResult.AdminResponse))
                {
                    <div class="alert alert-info border-info mb-4 shadow-sm">
                        <h6 class="fw-bold mb-1"><i class="bi bi-building"></i> Відповідь міськради:</h6>
                        <span>@trackingResult.AdminResponse</span>
                    </div>
                }

                @if (trackingResult.Status == "Resolved" && !trackingResult.UserRating.HasValue)
                {
                    <div class="text-center p-4 bg-light rounded border border-warning shadow-sm">
                        <h6 class="fw-bold mb-3">Оцініть якість вирішення проблеми:</h6>
                        <div class="fs-2 text-warning mb-3">
                            @for (int i = 1; i <= 5; i++)
                            {
                                var ratingValue = i;
                                <i class="bi @(hoverRating >= ratingValue || selectedRating >= ratingValue ? "bi-star-fill" : "bi-star") mx-1" 
                                   style="cursor: pointer; transition: transform 0.2s;"
                                   @onmouseover="() => hoverRating = ratingValue"
                                   @onmouseout="() => hoverRating = 0"
                                   @onclick="() => SetRating(ratingValue)"></i>
                            }
                        </div>
                        <button class="btn btn-warning fw-bold px-4 rounded-pill" disabled="@(selectedRating == 0 || isSubmittingRating)" @onclick="SubmitRating">
                            @if (isSubmittingRating) { <span class="spinner-border spinner-border-sm"></span> }
                            else { <span>Надіслати оцінку</span> }
                        </button>
                    </div>
                }
                else if (trackingResult.UserRating.HasValue)
                {
                    <div class="text-center p-3 bg-light rounded text-success border border-success">
                        <i class="bi bi-check-circle-fill fs-4 mb-2"></i>
                        <h6 class="fw-bold mb-1">Ви вже оцінили цю роботу</h6>
                        <div class="text-warning fs-5 mt-2">
                            @for (int i = 0; i < trackingResult.UserRating.Value; i++) { <i class="bi bi-star-fill"></i> }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(trackingError))
    {
        <div class="alert alert-danger shadow-sm fw-bold text-center"><i class="bi bi-exclamation-triangle"></i> @trackingError</div>
    }
</div>

@code {
    private string trackingId = "";
    private CityIssueModel? trackingResult;
    private string trackingError = "";
    private bool isChecking = false;

    private int hoverRating = 0;
    private int selectedRating = 0;
    private bool isSubmittingRating = false;

    private async Task CheckStatus()
    {
        if (string.IsNullOrWhiteSpace(trackingId)) return;
        
        isChecking = true;
        trackingError = "";
        trackingResult = null;
        hoverRating = 0;
        selectedRating = 0;

        try
        {
            var response = await Http.GetAsync($"api/cityissues/tracking/{trackingId.Trim()}");
            if (response.IsSuccessStatusCode)
            {
                trackingResult = await response.Content.ReadFromJsonAsync<CityIssueModel>();
            }
            else
            {
                trackingError = "Заявку з таким номером не знайдено. Перевірте правильність вводу.";
            }
        }
        catch
        {
            trackingError = "Помилка з'єднання з сервером.";
        }
        finally
        {
            isChecking = false;
        }
    }

    private async Task HandleTrackingEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CheckStatus();
    }

    private void SetRating(int rating)
    {
        selectedRating = rating;
    }

    private async Task SubmitRating()
    {
        if (selectedRating == 0 || trackingResult == null) return;

        isSubmittingRating = true;
        try
        {
            var payload = new { Rating = selectedRating };
            var response = await Http.PutAsJsonAsync($"api/cityissues/{trackingResult.Id}/rate", payload);
            
            if (response.IsSuccessStatusCode)
            {
                trackingResult.UserRating = selectedRating;
            }
        }
        finally
        {
            isSubmittingRating = false;
        }
    }

    private string GetStatusText(string status) => status switch {
        "New" => "Очікує розгляду",
        "InProgress" => "В роботі (Передано службам)",
        "Resolved" => "Вирішено",
        "Rejected" => "Відхилено",
        _ => "Невідомо"
    };

    private string GetStatusAlertClass(string status) => status switch {
        "New" => "bg-danger",
        "InProgress" => "bg-warning text-dark",
        "Resolved" => "bg-success",
        "Rejected" => "bg-secondary",
        _ => "bg-dark"
    };

    private string GetStatusIconClass(string status) => status switch {
        "New" => "bi-exclamation-circle",
        "InProgress" => "bi-tools",
        "Resolved" => "bi-check-all",
        "Rejected" => "bi-x-circle",
        _ => "bi-question-circle"
    };
}