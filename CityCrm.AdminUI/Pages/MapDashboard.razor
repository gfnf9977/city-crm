@page "/map"
@using CityCrm.AdminUI.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>@(isAdmin ? "Карта нерухомості (Адмін)" : "Публічна карта міста")</PageTitle>

<div class="d-flex justify-content-between align-items-end mb-3">
    <h1>@(isAdmin ? "Просторова мапа нерухомості" : "Публічна карта Чернігова")</h1>
    
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <button class="btn @(activeFilter == "" ? "btn-secondary" : "btn-outline-secondary")" 
                    @onclick="@(() => ApplyFilter(""))">
                <i class="bi bi-globe"></i> Всі об'єкти
            </button>
            <button class="btn @(activeFilter == "free_communal" ? "btn-success" : "btn-outline-success")" 
                    @onclick="@(() => ApplyFilter("free_communal"))">
                Вільна комуналка
            </button>
            <button class="btn @(activeFilter == "commerce" ? "btn-primary" : "btn-outline-primary")" 
                    @onclick="@(() => ApplyFilter("commerce"))">
                Комерційні площі
            </button>
            <button class="btn @(activeFilter == "problems" ? "btn-danger" : "btn-outline-danger")" 
                    @onclick="@(() => ApplyFilter("problems"))">
                Зруйновані / Аварійні
            </button>
        }
        else
        {
            <div class="d-flex flex-column align-items-end gap-2">
                <div class="d-flex gap-2">
                    <select class="form-select border-primary shadow-sm" style="width: 220px;" 
                            @bind="publicSelectedCategory" @bind:after="FilterMapData">
                        <option value="">Всі категорії</option>
                        <option value="Продукти / Супермаркет">🛒 Продукти / Супермаркет</option>
                        <option value="Кафе / Ресторан">☕ Кафе / Ресторан</option>
                        <option value="СТО / Автомийка">🔧 СТО / Автомийка</option>
                        <option value="Аптека / Медицина">💊 Аптека / Медицина</option>
                        <option value="Послуги / Краса">✂️ Послуги / Краса</option>
                        <option value="Офіс / Відділення">🏢 Офіс / Відділення</option>
                        <option value="Інше">📦 Інше</option>
                    </select>

                    <div class="input-group shadow-sm" style="width: 320px;">
                        <span class="input-group-text bg-white border-primary"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" class="form-control border-primary" placeholder="Пошук закладу..."
                               @bind="publicSearchQuery" @bind:event="oninput" @onkeyup="FilterMapData" />
                        @if (!string.IsNullOrEmpty(publicSearchQuery))
                        {
                            <button class="btn btn-outline-primary" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
                        }
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(publicSearchQuery) || !string.IsNullOrEmpty(publicSelectedCategory))
                {
                    <small class="text-primary fw-bold mt-1 me-1">Знайдено закладів: @searchResultsCount</small>
                }
            </div>
        }
    </div>
</div>

@if (isLoading)
{
    <div class="alert alert-info">Завантаження даних просторової бази...</div>
}

<div id="map" style="height: calc(100vh - 160px); min-height: 600px; width: 100%; border-radius: 8px; border: 1px solid #ccc; z-index: 1;"></div>

@code {
    private bool isMapInitialized = false;
    private bool isLoading = true;
    private string activeFilter = "";
    private bool isAdmin = false;
    private List<Building> cachedBuildings = new();
    private string publicSearchQuery = "";
    private string publicSelectedCategory = "";
    private int searchResultsCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.Identity?.IsAuthenticated == true && 
                  (user.IsInRole("GrandAdmin") || user.IsInRole("Admin"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.init", "map");
            isMapInitialized = true;
            
            await LoadDataFromServer("");
        }
    }

    private async Task ApplyFilter(string filterType)
    {
        activeFilter = filterType;
        await LoadDataFromServer(activeFilter);
    }

    private async Task LoadDataFromServer(string filterType)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new List<string>();
            
            if (filterType == "free_communal")
            {
                queryParams.Add("pOwnership=" + Uri.EscapeDataString("Комунальна"));
                queryParams.Add("pStatus=" + Uri.EscapeDataString("Вільне"));
            }
            else if (filterType == "commerce")
            {
                queryParams.Add("pType=" + Uri.EscapeDataString("Комерційна"));
            }
            else if (filterType == "problems")
            {
                queryParams.Add("pStatus=" + Uri.EscapeDataString("Аварійне"));
            }

            var url = "api/buildings";
            if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

            var buildings = await Http.GetFromJsonAsync<List<Building>>(url);

            if (buildings != null)
            {
                cachedBuildings = buildings;
                await RenderMap();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Помилка завантаження карти: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FilterMapData()
    {
        await RenderMap();
    }

    private async Task ClearSearch()
    {
        publicSearchQuery = "";
        await RenderMap();
    }

    private string NormalizeStr(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        var chars = input.Where(c => !char.IsPunctuation(c)).ToArray();
        return new string(chars).ToLower();
    }

    private async Task RenderMap()
    {
        if (!isMapInitialized || cachedBuildings == null) return;

        var query = NormalizeStr(publicSearchQuery);
        var catQuery = publicSelectedCategory;
        
        bool isSearchActive = !isAdmin && (!string.IsNullOrWhiteSpace(query) || !string.IsNullOrWhiteSpace(catQuery));
        searchResultsCount = 0;

        var mapData = cachedBuildings.Select(b => 
        {
            var visiblePremises = isAdmin
                ? b.Premises
                : b.Premises.Where(p => p.IsPublicVisible).ToList();

            if (isSearchActive)
            {
                visiblePremises = visiblePremises.Where(p => 
                    (string.IsNullOrWhiteSpace(catQuery) || p.BusinessCategory == catQuery) &&
                    (string.IsNullOrWhiteSpace(query) || 
                     NormalizeStr(p.BusinessName).Contains(query) ||
                     NormalizeStr(p.BusinessCategory).Contains(query) ||
                     NormalizeStr(p.BusinessDescription).Contains(query))
                ).ToList();
            }

            return new 
            {
                id = b.Id,
                lat = b.Lat,
                lng = b.Lng,
                address = b.FullAddress,
                buildingType = b.BuildingType,
                condition = isAdmin ? b.Condition : "В експлуатації",
                hasShelter = b.HasShelter,    
                geoJson = b.GeoJson,
                notes = isAdmin ? b.Notes : null,
                premises = visiblePremises.Select(p => new {
                    number = p.PremiseNumber,
                    area = p.Area,
                    type = p.Type,
                    status = p.Status,
                    notes = isAdmin ? p.Notes : null,
                    businessName = p.BusinessName,
                    businessCategory = p.BusinessCategory,
                    businessDescription = p.BusinessDescription,
                    workingHours = p.WorkingHours,
                    isInclusive = p.IsInclusive
                }).ToList()
            };
        })
        .Where(b => isAdmin || b.premises.Any())
        .ToList();

        if (isSearchActive)
        {
            searchResultsCount = mapData.Sum(b => b.premises.Count);
        }

        await JSRuntime.InvokeVoidAsync("leafletMap.loadData", mapData, isAdmin, isSearchActive);
    }
}