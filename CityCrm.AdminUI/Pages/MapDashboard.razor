@page "/map"
@using CityCrm.AdminUI.Models
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>@(isAdmin ? "Карта нерухомості (Адмін)" : isInvestorMode ? "Карта інвестора" : "Публічна карта міста")</PageTitle>

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start mb-3 gap-3">
    <div class="d-flex flex-column gap-2">
        <h3 class="fw-bold mb-1 text-dark">
            @(isAdmin ? "Просторова мапа нерухомості" : isInvestorMode ? "Вільні площі для інвестицій" : "Публічна карта Чернігова")
        </h3>
        
        @if (!isAdmin)
        {
            @if (isInvestorMode)
            {
                <div class="d-flex align-items-center gap-2 mt-1">
                    <div class="alert alert-success py-2 px-3 mb-0 shadow-sm d-inline-flex align-items-center border-success border-start border-4">
                        <i class="bi bi-info-circle-fill me-2 text-success"></i> Відображається лише вільна комуналка
                    </div>
                    <button class="btn btn-outline-secondary shadow-sm bg-white" @onclick="ExitInvestorMode">
                        <i class="bi bi-arrow-left"></i> На звичайну карту
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center gap-3 mt-1">
                    <button class="btn btn-outline-primary shadow-sm rounded-circle" style="width: 40px; height: 40px; padding: 0;" @onclick="LocateMe" title="Знайти мене">
                        <i class="bi bi-crosshair"></i>
                    </button>

                    <button class="btn @(isPickingIssueLocation ? "btn-danger" : "btn-outline-danger") shadow-sm rounded-pill px-3" @onclick="ToggleIssuePickingMode">
                        @if (isPickingIssueLocation)
                        {
                            <span><i class="bi bi-x-circle"></i> Скасувати вибір</span>
                        }
                        else
                        {
                            <span><i class="bi bi-exclamation-triangle-fill"></i> Повідомити про проблему</span>
                        }
                    </button>

                    <div class="form-check form-switch mb-0 bg-white px-3 py-1 rounded shadow-sm border">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="showIssues" @bind="showIssuesOnMap" @bind:after="ToggleIssuesVisibility" />
                        <label class="form-check-label text-danger fw-bold" style="font-size: 0.85rem; cursor: pointer;" for="showIssues">
                            Показати інциденти
                        </label>
                    </div>
                </div>
            }
        }
    </div>
    
    <div class="d-flex gap-2">
        @if (isAdmin)
        {
            <div class="d-flex gap-2 align-items-center">
                <button class="btn @(activeFilter == "" ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => ApplyFilter(""))"><i class="bi bi-globe"></i> Всі об'єкти</button>
                <button class="btn @(activeFilter == "free_communal" ? "btn-success" : "btn-outline-success")" @onclick="@(() => ApplyFilter("free_communal"))">Вільна комуналка</button>
                <button class="btn @(activeFilter == "commerce" ? "btn-primary" : "btn-outline-primary")" @onclick="@(() => ApplyFilter("commerce"))">Комерційні площі</button>
                <button class="btn @(activeFilter == "problems" ? "btn-danger" : "btn-outline-danger")" @onclick="@(() => ApplyFilter("problems"))">Зруйновані / Аварійні</button>
            </div>
        }
        else if (!isInvestorMode)
        {
            <div class="d-flex flex-column align-items-end gap-2">
                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select border-primary shadow-sm rounded-pill px-3" style="width: 220px;" @bind="publicSelectedCategory" @bind:after="FilterMapData">
                        <option value="">Всі категорії закладів</option>
                        <option value="Продукти / Супермаркет">🛒 Продукти / Супермаркет</option>
                        <option value="Кафе / Ресторан">☕ Кафе / Ресторан</option>
                        <option value="СТО / Автомийка">🔧 СТО / Автомийка</option>
                        <option value="Аптека / Медицина">💊 Аптека / Медицина</option>
                        <option value="Послуги / Краса">✂️ Послуги / Краса</option>
                        <option value="Офіс / Відділення">🏢 Офіс / Відділення</option>
                        <option value="Інше">📦 Інше</option>
                    </select>

                    <div class="input-group shadow-sm rounded-pill overflow-hidden" style="width: 300px;">
                        <span class="input-group-text bg-white border-primary border-end-0"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" class="form-control border-primary border-start-0 shadow-none" placeholder="Шукати заклад..."
                               @bind="publicSearchQuery" @bind:event="oninput" @onkeyup="FilterMapData" />
                        @if (!string.IsNullOrEmpty(publicSearchQuery))
                        {
                            <button class="btn btn-white border-primary border-start-0 text-muted" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
                        }
                    </div>
                </div>
                
                <div class="d-flex gap-3 mt-1 bg-white px-3 py-1 rounded shadow-sm border">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="shelterFilter" @bind="filterHasShelter" @bind:after="FilterMapData" />
                        <label class="form-check-label text-success fw-bold" style="font-size: 0.85rem; cursor: pointer;" for="shelterFilter"><i class="bi bi-shield-shaded"></i> З укриттям</label>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input ms-0 me-2" type="checkbox" id="inclusiveFilter" @bind="filterIsInclusive" @bind:after="FilterMapData" />
                        <label class="form-check-label text-primary fw-bold" style="font-size: 0.85rem; cursor: pointer;" for="inclusiveFilter"><i class="bi bi-person-wheelchair"></i> Безбар'єрні</label>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (isPickingIssueLocation)
{
    <div class="alert alert-danger shadow fw-bold text-center mb-3">
        <i class="bi bi-crosshair"></i> Клікніть на карті місце, де виявлено проблему (яма, неробочий ліхтар, сміття тощо).
    </div>
}

@if (isLoading)
{
    <div class="alert alert-info">Завантаження даних просторової бази...</div>
}

<div id="map" style="height: calc(100vh - 160px); min-height: 600px; width: 100%; border-radius: 8px; border: 1px solid #ccc; z-index: 1;"></div>

@if (showIssueModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); z-index: 2000;">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cone-striped"></i> Фіксація проблеми</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseIssueModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (issueSubmitted)
                    {
                        <div class="text-center">
                            <i class="bi bi-check-circle-fill text-success display-1 mb-3"></i>
                            <h4>Дякуємо за небайдужість!</h4>
                            <p>Заявку успішно передано до міських служб.</p>
                            <p class="text-muted small">Ваш номер для відстеження статусу:</p>
                            <h3 class="fw-bold text-primary">@createdIssueTrackingNumber</h3>
                            <button class="btn btn-secondary mt-3" @onclick="CloseIssueModal">Закрити</button>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small"><i class="bi bi-geo-alt-fill text-danger"></i> Координати: @newIssue.Lat, @newIssue.Lng</p>
                        
                        <EditForm Model="newIssue" OnValidSubmit="SubmitIssue">
                            <DataAnnotationsValidator />
                            
                            <div class="mb-3">
                                <label class="form-label fw-bold">Категорія проблеми</label>
                                <InputSelect class="form-select" @bind-Value="newIssue.Category">
                                    <option value="">Оберіть...</option>
                                    <option value="Дороги і тротуари">Дороги і тротуари (ями, люки)</option>
                                    <option value="Освітлення">Зовнішнє освітлення (ліхтарі)</option>
                                    <option value="Благоустрій">Благоустрій (парки, лавки)</option>
                                    <option value="Сміття">Вивіз сміття / Стихійні звалища</option>
                                    <option value="ЖКГ (Труби/Тепло)">Аварії мереж ЖКГ</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => newIssue.Category)" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Опис проблеми</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="newIssue.Description" placeholder="Наприклад: Глибока яма на переході, неможливо проїхати з візочком." />
                                <ValidationMessage For="@(() => newIssue.Description)" class="text-danger small" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">Посилання на фото (якщо є)</label>
                                <InputText class="form-control" @bind-Value="newIssue.PhotoUrl" placeholder="Google Drive / Telegram лінк" />
                            </div>

                            @if (!string.IsNullOrEmpty(issueSubmitError))
                            {
                                <div class="alert alert-danger p-2 small">@issueSubmitError</div>
                            }

                            <div class="text-end">
                                <button type="button" class="btn btn-secondary me-2" @onclick="CloseIssueModal">Скасувати</button>
                                <button type="submit" class="btn btn-danger" disabled="@isSubmittingIssue">
                                    @if (isSubmittingIssue) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <span>Відправити</span> }
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "report")]
    public bool ReportIssueParam { get; set; }

    [SupplyParameterFromQuery(Name = "filter")]
    public string? InitialFilter { get; set; }
    
    private bool isInvestorMode = false;
    private bool isMapInitialized = false;
    private bool isLoading = true;
    private string activeFilter = "";
    private bool isAdmin = false;
    private List<Building> cachedBuildings = new();
    private List<CityIssueModel> cachedIssues = new();

    private string publicSearchQuery = "";
    private string publicSelectedCategory = "";
    private int searchResultsCount = 0;
    private bool filterHasShelter = false;
    private bool filterIsInclusive = false;
    private bool showIssuesOnMap = false;

    private bool isPickingIssueLocation = false;
    private bool showIssueModal = false;
    private CityIssueModel newIssue = new();
    private bool isSubmittingIssue = false;
    private bool issueSubmitted = false;
    private string createdIssueTrackingNumber = "";
    private string issueSubmitError = "";
    
    private DotNetObjectReference<MapDashboard>? objRef;

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.Identity?.IsAuthenticated == true && 
                  (user.IsInRole("GrandAdmin") || user.IsInRole("Admin"));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.init", "map", objRef);
            isMapInitialized = true;
            
            if (InitialFilter == "free_communal" && !isAdmin)
            {
                isInvestorMode = true;
                await LoadDataFromServer("free_communal");
            }
            else
            {
                await LoadDataFromServer("");
                if (!isAdmin) 
                { 
                    await LoadIssuesFromServer(); 
                    if (ReportIssueParam) await ToggleIssuePickingMode();
                } 
            }
        }
    }

    private async Task ExitInvestorMode()
    {
        isInvestorMode = false;
        await LoadDataFromServer("");
        await LoadIssuesFromServer();
    }

    private async Task LocateMe()
    {
        await JSRuntime.InvokeVoidAsync("leafletMap.locateUser");
    }

    private async Task ToggleIssuePickingMode()
    {
        isPickingIssueLocation = !isPickingIssueLocation;
        if (isPickingIssueLocation)
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.enableIssuePicker");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.disableIssuePicker");
        }
    }

    [JSInvokable]
    public void OnMapClicked(double lat, double lng)
    {
        isPickingIssueLocation = false;
        newIssue = new CityIssueModel { Lat = lat, Lng = lng };
        issueSubmitted = false;
        createdIssueTrackingNumber = "";
        issueSubmitError = "";
        showIssueModal = true;
        StateHasChanged();
    }

    private void CloseIssueModal()
    {
        showIssueModal = false;
    }

    private async Task SubmitIssue()
    {
        isSubmittingIssue = true;
        issueSubmitError = "";
        
        try
        {
            var response = await Http.PostAsJsonAsync("api/cityissues", newIssue);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Dictionary<string, object>>();
                if (result != null && result.ContainsKey("trackingNumber"))
                {
                    createdIssueTrackingNumber = result["trackingNumber"].ToString()!;
                    issueSubmitted = true;
                    await LoadIssuesFromServer();
                    if (showIssuesOnMap) await ToggleIssuesVisibility();
                }
            }
            else
            {
                issueSubmitError = "Помилка сервера. Спробуйте пізніше.";
            }
        }
        catch
        {
            issueSubmitError = "Проблема з'єднання.";
        }
        finally
        {
            isSubmittingIssue = false;
        }
    }

    private async Task LoadIssuesFromServer()
    {
        try
        {
            var issues = await Http.GetFromJsonAsync<List<CityIssueModel>>("api/cityissues/map");
            if (issues != null) cachedIssues = issues;
        }
        catch { }
    }

    private async Task ToggleIssuesVisibility()
    {
        if (!isMapInitialized) return;
        if (showIssuesOnMap)
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.loadIssues", cachedIssues);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("leafletMap.loadIssues", new List<CityIssueModel>());
        }
    }

    private async Task ApplyFilter(string filterType)
    {
        activeFilter = filterType;
        await LoadDataFromServer(activeFilter);
    }

    private async Task LoadDataFromServer(string filterType)
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var queryParams = new List<string>();
            
            if (filterType == "free_communal")
            {
                queryParams.Add("pOwnership=" + Uri.EscapeDataString("Комунальна"));
                queryParams.Add("pStatus=" + Uri.EscapeDataString("Вільне"));
            }
            else if (filterType == "commerce")
            {
                queryParams.Add("pType=" + Uri.EscapeDataString("Комерційна"));
            }
            else if (filterType == "problems")
            {
                queryParams.Add("pStatus=" + Uri.EscapeDataString("Аварійне"));
            }

            var url = "api/buildings";
            if (queryParams.Any()) url += "?" + string.Join("&", queryParams);

            var buildings = await Http.GetFromJsonAsync<List<Building>>(url);

            if (buildings != null)
            {
                cachedBuildings = buildings;
                await RenderMap();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Помилка завантаження карти: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task FilterMapData()
    {
        await RenderMap();
    }

    private async Task ClearSearch()
    {
        publicSearchQuery = "";
        await RenderMap();
    }

    private string NormalizeStr(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        var chars = input.Where(c => !char.IsPunctuation(c)).ToArray();
        return new string(chars).ToLower();
    }

    private async Task RenderMap()
    {
        if (!isMapInitialized || cachedBuildings == null) return;

        var query = NormalizeStr(publicSearchQuery);
        var catQuery = publicSelectedCategory;
        
        bool isSearchActive = !isAdmin && (!string.IsNullOrWhiteSpace(query) || !string.IsNullOrWhiteSpace(catQuery) || filterIsInclusive);
        searchResultsCount = 0;

        var mapData = cachedBuildings
        .Where(b => !filterHasShelter || b.HasShelter)
        .Select(b => 
        {
            List<Premise> visiblePremises;

            if (isAdmin) 
            {
                visiblePremises = b.Premises;
            }
            else if (isInvestorMode)
            {
                visiblePremises = b.Premises.Where(p => p.Ownership == "Комунальна" && p.Status == "Вільне" && p.Type == "Комерційна").ToList();
            }
            else
            {
                visiblePremises = b.Premises.Where(p => p.IsPublicVisible).ToList();
            }

            if (isSearchActive && !isInvestorMode)
            {
                visiblePremises = visiblePremises.Where(p => 
                    (!filterIsInclusive || p.IsInclusive) &&
                    (string.IsNullOrWhiteSpace(catQuery) || p.BusinessCategory == catQuery) &&
                    (string.IsNullOrWhiteSpace(query) || 
                     NormalizeStr(p.BusinessName).Contains(query) ||
                     NormalizeStr(p.BusinessCategory).Contains(query) ||
                     NormalizeStr(p.BusinessDescription).Contains(query))
                ).ToList();
            }

            return new 
            {
                id = b.Id,
                lat = b.Lat,
                lng = b.Lng,
                address = b.FullAddress,
                buildingType = b.BuildingType,
                condition = isAdmin ? b.Condition : "В експлуатації",
                hasShelter = b.HasShelter,
                geoJson = b.GeoJson,
                notes = isAdmin ? b.Notes : null,
                premises = visiblePremises.Select(p => new {
                    id = p.Id,
                    ownership = p.Ownership,
                    number = p.PremiseNumber,
                    area = p.Area,
                    type = p.Type,
                    status = p.Status,
                    notes = isAdmin ? p.Notes : null,
                    businessName = p.BusinessName,
                    businessCategory = p.BusinessCategory,
                    businessDescription = p.BusinessDescription,
                    workingHours = p.WorkingHours,
                    isInclusive = p.IsInclusive
                }).ToList()
            };
        })
        .Where(b => isAdmin || b.premises.Any() || (filterHasShelter && b.hasShelter))
        .ToList();

        if (isSearchActive && !filterHasShelter && !isInvestorMode)
        {
            searchResultsCount = mapData.Sum(b => b.premises.Count);
        }

        await JSRuntime.InvokeVoidAsync("leafletMap.loadData", mapData, isAdmin, isSearchActive || filterHasShelter);
    }
    
    public void Dispose()
    {
        objRef?.Dispose();
    }
}