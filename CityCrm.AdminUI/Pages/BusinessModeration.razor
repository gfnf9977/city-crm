@page "/moderation"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "GrandAdmin, Admin")]
@using CityCrm.AdminUI.Models
@using CityCrm.AdminUI.Components
@inject HttpClient Http

<PageTitle>Модерація бізнесу</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-shield-check text-primary"></i> Модерація заявок від бізнесу</h1>
    <button class="btn btn-outline-secondary" @onclick="LoadRequests"><i class="bi bi-arrow-clockwise"></i> Оновити</button>
</div>

@if (isLoading)
{
    <div class="alert alert-info">Завантаження заявок...</div>
}
else if (!requests.Any())
{
    <div class="card border-0 shadow-sm opacity-75 text-center p-5">
        <i class="bi bi-check2-circle display-1 text-success mb-3"></i>
        <h4 class="text-muted">Усі заявки перевірено</h4>
        <p>Наразі немає нових запитів від підприємців.</p>
    </div>
}
else
{
    <ul class="nav nav-tabs mb-3">
        <li class="nav-item">
            <a class="nav-link @(activeTab == "Pending" ? "active fw-bold" : "")" 
               style="cursor:pointer;" @onclick="@(() => activeTab = "Pending")">
                Очікують розгляду 
                <span class="badge bg-danger ms-1">@requests.Count(r => r.Status == "Pending")</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(activeTab == "History" ? "active fw-bold" : "")" 
               style="cursor:pointer;" @onclick="@(() => activeTab = "History")">
                Історія (Оброблені)
            </a>
        </li>
    </ul>

    <div class="table-responsive bg-white rounded shadow-sm border">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Дата</th>
                    <th>ФОП / Компанія</th>
                    <th>Сфера / Назва</th>
                    <th>Заявлена адреса</th>
                    <th>Статус</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var req in requests.Where(r => activeTab == "Pending" ? r.Status == "Pending" : r.Status != "Pending"))
                {
                    <tr class="@(req.Status != "Pending" ? "table-light text-muted" : "")">
                        <td class="small">@req.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="fw-bold">@req.LegalName <br/><small class="fw-normal">ЄДРПОУ: @req.Edrpou</small></td>
                        <td>
                            <span class="badge bg-secondary mb-1">@req.BusinessCategory</span><br/>
                            @(req.IsNetwork ? (string.IsNullOrWhiteSpace(req.LocalName) ? req.NetworkName : $"{req.NetworkName} ({req.LocalName})") : req.LocalName)
                        </td>
                        <td>
                            @req.Street?.DisplayName, @req.BuildingNumber@req.BuildingLetter
                            @if (!string.IsNullOrEmpty(req.PremiseNumber)) { <span>, кв/оф @req.PremiseNumber</span> }
                        </td>
                        <td>
                            @if (req.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> Нова</span>
                            }
                            else if (req.Status == "Approved")
                            {
                                <span class="badge bg-success"><i class="bi bi-check-lg"></i> Опубліковано</span>
                            }
                            else if (req.Status == "Rejected")
                            {
                                <span class="badge bg-danger"><i class="bi bi-x-lg"></i> Відхилено</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (req.Status == "Pending")
                            {
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenRequestModal(req)">Розглянути</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" disabled>Оброблено</button>
                            }
                        </td>
                    </tr>
                }
                
                @if (!requests.Any(r => activeTab == "Pending" ? r.Status == "Pending" : r.Status != "Pending"))
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Немає записів у цій категорії.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showRequestModal && selectedRequest != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold">Деталі заявки #@selectedRequest.Id</h5>
                    <button type="button" class="btn-close" @onclick="CloseRequestModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3 border-bottom pb-3">
                        <div class="col-md-6">
                            <h6 class="text-muted mb-1">Юридичні дані</h6>
                            <div><strong>Компанія:</strong> @selectedRequest.LegalName</div>
                            <div><strong>ЄДРПОУ:</strong> @selectedRequest.Edrpou</div>
                            <div><strong>Контакт:</strong> @selectedRequest.ContactInfo</div>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-muted mb-1">Опис послуг</h6>
                            <div class="fst-italic small">@(string.IsNullOrEmpty(selectedRequest.Description) ? "Немає опису" : selectedRequest.Description)</div>
                            <div class="mt-2">
                                @if (!string.IsNullOrEmpty(selectedRequest.ReferenceLink))
                                {
                                    <a href="@selectedRequest.ReferenceLink" target="_blank" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-link-45deg"></i> Перевірити посилання
                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning mb-4">
                        <h6 class="fw-bold mb-2"><i class="bi bi-geo-alt"></i> Прив'язка до Реєстру</h6>
                        <p class="small mb-2">
                            Заявлена адреса: <strong>@selectedRequest.Street?.DisplayName, @selectedRequest.BuildingNumber@selectedRequest.BuildingLetter</strong>.
                            Оберіть існуючу будівлю з Реєстру.
                        </p>
                        
                        @if (isBuildingsLoading)
                        {
                            <div><span class="spinner-border spinner-border-sm text-primary"></span> <span class="ms-2">Шукаю будівлі на цій вулиці...</span></div>
                        }
                        else if (!streetBuildings.Any())
                        {
                            <div class="text-danger fw-bold mb-2">
                                Будівель на цій вулиці ще немає в Реєстрі! Спочатку створіть її в розділі "Реєстр нерухомості".
                            </div>
                        }
                        else
                        {
                            <select class="form-select border-primary" @bind="selectedBuildingId">
                                <option value="0">-- Оберіть будівлю --</option>
                                @foreach (var b in streetBuildings)
                                {
                                    <option value="@b.Id">@b.FullAddress (@b.BuildingType)</option>
                                }
                            </select>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger p-2">@errorMessage</div>
                    }

                    <div class="d-flex justify-content-between">
                        <button class="btn btn-outline-danger" @onclick="RejectRequest" disabled="@isProcessing">
                            <i class="bi bi-x-lg"></i> Відхилити як спам
                        </button>
                        <button class="btn btn-primary fw-bold px-4" @onclick="PreparePremiseModal" disabled="@(selectedBuildingId == 0)">
                            <span><i class="bi bi-pencil-square"></i> Редагувати та Схвалити</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<PremiseModal IsVisible="showPremiseModal"
              Model="newPremise"
              BuildingType="@targetBuildingType"
              ExistingPremises="@targetExistingPremises"
              OnSaved="HandlePremiseSaved"
              OnClosed="ClosePremiseModal" />

@code {
    private List<BusinessRequestModel> requests = new();
    private bool isLoading = true;
    private string activeTab = "Pending";
    
    private BusinessRequestModel? selectedRequest;
    private bool showRequestModal = false;
    private List<Building> streetBuildings = new();
    private int selectedBuildingId = 0;
    private bool isBuildingsLoading = false;
    private bool isProcessing = false;
    private string errorMessage = "";

    private bool showPremiseModal = false;
    private Premise newPremise = new();
    private string targetBuildingType = "";
    private List<Premise> targetExistingPremises = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRequests();
    }

    private async Task LoadRequests()
    {
        isLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<BusinessRequestModel>>("api/businessrequests");
            if (result != null) requests = result;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenRequestModal(BusinessRequestModel req)
    {
        selectedRequest = req;
        selectedBuildingId = 0;
        errorMessage = "";
        showRequestModal = true;
        
        isBuildingsLoading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<Building>>($"api/buildings?search={Uri.EscapeDataString(req.Street?.Name ?? "")}");
            if (result != null)
            {
                streetBuildings = result.Where(b => b.StreetId == req.StreetId).ToList();
                
                var exactMatch = streetBuildings.FirstOrDefault(b => 
                    b.BuildingNumber == req.BuildingNumber && 
                    string.Equals(b.BuildingLetter, req.BuildingLetter, StringComparison.OrdinalIgnoreCase));
                    
                if (exactMatch != null) selectedBuildingId = exactMatch.Id;
            }
        }
        finally
        {
            isBuildingsLoading = false;
        }
    }

    private void CloseRequestModal()
    {
        showRequestModal = false;
        selectedRequest = null;
    }

    private void PreparePremiseModal()
    {
        if (selectedBuildingId == 0)
        {
            errorMessage = "Будь ласка, оберіть будівлю з Реєстру.";
            return;
        }

        var targetBuilding = streetBuildings.FirstOrDefault(b => b.Id == selectedBuildingId);
        if (targetBuilding == null) return;

        targetBuildingType = targetBuilding.BuildingType;
        targetExistingPremises = targetBuilding.Premises;

        var premiseName = selectedRequest!.IsNetwork 
            ? (string.IsNullOrWhiteSpace(selectedRequest.LocalName) 
                ? selectedRequest.NetworkName 
                : $"{selectedRequest.NetworkName} ({selectedRequest.LocalName})") 
            : selectedRequest.LocalName;

        newPremise = new Premise
        {
            BuildingId = selectedBuildingId,
            PremiseNumber = selectedRequest.PremiseNumber ?? "",
            Area = 0, 
            Type = "Комерційна",
            Status = "В експлуатації",
            Ownership = "Приватна",
            OwnerName = selectedRequest.LegalName,
            BusinessCategory = selectedRequest.BusinessCategory,
            BusinessName = premiseName,
            BusinessDescription = selectedRequest.Description,
            WorkingHours = selectedRequest.WorkingHours,
            IsInclusive = selectedRequest.IsInclusive,
            IsPublicVisible = true, 
            Notes = $"Заявка з порталу.\nЄДРПОУ: {selectedRequest.Edrpou}\nКонтакт: {selectedRequest.ContactInfo}"
        };

        showRequestModal = false; 
        showPremiseModal = true;  
    }

    private async Task HandlePremiseSaved()
    {
        showPremiseModal = false;
        
        if (selectedRequest != null)
        {
            await Http.PutAsync($"api/businessrequests/{selectedRequest.Id}/approve", null);
            selectedRequest = null;
            await LoadRequests();
        }
    }

    private void ClosePremiseModal()
    {
        showPremiseModal = false;
        selectedRequest = null; 
    }

    private async Task RejectRequest()
    {
        isProcessing = true;
        try
        {
            var response = await Http.PutAsync($"api/businessrequests/{selectedRequest!.Id}/reject", null);
            if (response.IsSuccessStatusCode)
            {
                await LoadRequests();
                CloseRequestModal();
            }
        }
        finally
        {
            isProcessing = false;
        }
    }
}