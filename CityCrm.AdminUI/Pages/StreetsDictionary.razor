@page "/streets"
@using CityCrm.AdminUI.Models
@using CityCrm.AdminUI.Components
@inject HttpClient Http

<PageTitle>Довідник вулиць</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Довідник вулиць міста</h1>
    <AuthorizeView Roles="GrandAdmin, Admin">
        <Authorized>
            <button class="btn btn-success" @onclick="ShowAddModal">
                <i class="bi bi-plus-circle"></i> Додати вулицю
            </button>
        </Authorized>
    </AuthorizeView>
</div>

<div class="card mb-3 shadow-sm border-0 bg-light">
    <div class="card-body p-3">
        <div class="d-flex gap-2">
            <input type="text" class="form-control" placeholder="Пошук за назвою або колишніми назвами..."
                   @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearchEnter" />
            <button class="btn btn-primary px-4" @onclick="LoadStreets"><i class="bi bi-search"></i> Знайти</button>
            <button class="btn btn-outline-secondary" @onclick="ResetSearch">Скинути</button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center my-5">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2 text-muted">Завантаження довідника...</div>
    </div>
}
else
{
    <div class="table-responsive rounded shadow-sm border">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 80px;">ID</th>
                    <th style="width: 100px;">Тип</th>
                    <th>Назва</th>
                    <th>Колишні назви</th>
                    <th style="width: 120px;" class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @if (!streets.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-3">Немає записів...</td></tr>
                }
                else
                {
                    @foreach (var street in streets)
                    {
                        <tr>
                            <td class="text-muted">@street.Id</td>
                            <td><span class="badge bg-secondary">@street.StreetType</span></td>
                            <td class="fw-bold">@street.Name</td>
                            <td class="text-muted">@street.OldNames</td>
                            <td class="text-center">
                                <AuthorizeView Roles="GrandAdmin, Admin">
                                    <Authorized>
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ShowEditModal(street)" title="Виправити помилку">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => ShowRenameModal(street)" title="Офіційне перейменування">
                                            <i class="bi bi-signpost-split"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteStreet(street.Id)" title="Видалити">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </Authorized>
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="text-muted mt-2 small text-end">
        Всього записів: @streets.Count
    </div>
}

<StreetModal IsVisible="showModal"
             Model="currentStreet"
             OnSaved="HandleSaved"
             OnClosed="CloseModal" />

<StreetRenameModal IsVisible="showRenameModal"
                   Model="currentStreet"
                   OnSaved="HandleSaved"
                   OnClosed="CloseModal" />

@code {
    private List<Street> streets = new();
    private bool isLoading = true;
    private string searchQuery = "";

    private bool showModal = false;
    private bool showRenameModal = false;
    private Street currentStreet = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStreets();
    }

    private async Task HandleSearchEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadStreets();
    }

    private async Task ResetSearch()
    {
        searchQuery = "";
        await LoadStreets();
    }

    private async Task LoadStreets()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var url = "api/streets";
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                url += $"?search={Uri.EscapeDataString(searchQuery)}";
            }

            var result = await Http.GetFromJsonAsync<List<Street>>(url);
            if (result != null)
            {
                streets = result;
            }
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void ShowAddModal()
    {
        currentStreet = new Street { StreetType = "вул." };
        showModal = true;
    }

    private void ShowEditModal(Street s)
    {
        currentStreet = new Street
        {
            Id = s.Id,
            StreetType = s.StreetType,
            Name = s.Name,
            OldNames = s.OldNames
        };
        showModal = true;
    }

    private void ShowRenameModal(Street s)
    {
        currentStreet = new Street
        {
            Id = s.Id,
            StreetType = s.StreetType,
            Name = s.Name,
            OldNames = s.OldNames
        };
        showRenameModal = true;
    }

    private async Task DeleteStreet(int id)
    {
        var response = await Http.DeleteAsync($"api/streets/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadStreets();
        }
    }

    private async Task HandleSaved()
    {
        showModal = false;
        showRenameModal = false;
        await LoadStreets();
    }

    private void CloseModal()
    {
        showModal = false;
        showRenameModal = false;
    }
}