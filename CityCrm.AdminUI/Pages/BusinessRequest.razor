@page "/business-request"
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Відповідальний бізнес | CityCrm</PageTitle>

<div class="container py-4" style="max-width: 850px;">
    <h2 class="fw-bold text-dark mb-3"><i class="bi bi-shop text-warning"></i> Додати бізнес на карту міста</h2>
    <p class="text-muted mb-4">
        Заповніть форму нижче. Якщо ви представляєте мережу, ви можете додати одразу кілька відділень в одній заявці.
    </p>

    <div class="card bg-light border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-search fs-3 text-primary me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Перевірити статус заявки</h6>
                    <small class="text-muted">Введіть трекінг-номер (BIZ-...)</small>
                </div>
            </div>
            <div class="input-group" style="max-width: 300px;">
                <input type="text" class="form-control" placeholder="BIZ-..." @bind="trackingId" @bind:event="oninput" @onkeyup="HandleTrackingEnter" />
                <button class="btn btn-primary" @onclick="CheckStatus">
                    @if (isCheckingStatus) { <span class="spinner-border spinner-border-sm"></span> }
                    else { <span>Перевірити</span> }
                </button>
            </div>
        </div>
        
        @if (trackingResult != null)
        {
            <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                <h6 class="fw-bold mb-2">Заявка #@trackingResult.TrackingNumber — @trackingResult.Name</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr><th>Відділення</th><th>Адреса</th><th>Статус</th></tr>
                        </thead>
                        <tbody class="small">
                            @foreach(var b in trackingResult.Branches)
                            {
                                <tr>
                                    <td class="fw-bold">@b.Name</td>
                                    <td>@b.Address</td>
                                    <td>
                                        <span class="badge @GetStatusAlertClass(b.Status)">
                                            <i class="bi @GetStatusIconClass(b.Status)"></i> @GetStatusText(b.Status)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(trackingError))
        {
            <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                <div class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle"></i> @trackingError</div>
            </div>
        }
    </div>

    @if (isSubmitted)
    {
        <div class="alert alert-success shadow-sm p-5 text-center border-0" style="background-color: #e6ffe6;">
            <i class="bi bi-check-circle-fill text-success display-1 d-block mb-3"></i>
            <h3 class="fw-bold">Заявку успішно прийнято!</h3>
            <p class="fs-5 mb-2">Ваш загальний номер для відстеження:</p>
            <div class="display-4 fw-bold text-success mb-4 copyable-text" style="letter-spacing: 2px;" title="Копіювати код" @onclick='() => JS.InvokeVoidAsync("copyToClipboard", submittedTrackingNumber)'>
                @submittedTrackingNumber <i class="bi bi-copy fs-4 ms-2 text-muted"></i>
            </div>
            <button class="btn btn-success px-4 rounded-pill" @onclick="ResetForm">Подати ще одну заявку</button>
        </div>
    }
    else
    {
        <EditForm Model="bulkModel" OnValidSubmit="SubmitRequest">
            <DataAnnotationsValidator />

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold text-secondary">
                    <i class="bi bi-file-earmark-person"></i> Юридична інформація (Конфіденційно)
                </div>
                <div class="card-body row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">ЄДРПОУ / ІПН</label>
                        <InputText class="form-control" @bind-Value="bulkModel.Edrpou" placeholder="12345678" />
                        <ValidationMessage For="@(() => bulkModel.Edrpou)" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Офіційна назва ФОП/ТОВ</label>
                        <InputText class="form-control" @bind-Value="bulkModel.LegalName" placeholder="ТОВ 'Сільпо'" />
                        <ValidationMessage For="@(() => bulkModel.LegalName)" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Контакт (Телефон/Email)</label>
                        <InputText class="form-control" @bind-Value="bulkModel.ContactInfo" placeholder="Для модератора" />
                        <ValidationMessage For="@(() => bulkModel.ContactInfo)" class="text-danger small" />
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold text-secondary">
                    <i class="bi bi-shop"></i> Загальні публічні дані
                </div>
                <div class="card-body row g-3">
                    <div class="col-12">
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox class="form-check-input" id="isNet" @bind-Value="bulkModel.IsNetwork" @bind-Value:after="OnNetworkToggleAfter" />
                            <label class="form-check-label fw-bold text-primary" for="isNet">Це мережевий заклад (супермаркет, пошта, банк)?</label>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Сфера діяльності</label>
                        <InputSelect class="form-select" @bind-Value="bulkModel.BusinessCategory">
                            <option value="">Оберіть категорію...</option>
                            <option value="Продукти / Супермаркет">🛒 Продукти / Супермаркет</option>
                            <option value="Кафе / Ресторан">☕ Кафе / Ресторан</option>
                            <option value="СТО / Автомийка">🔧 СТО / Автомийка</option>
                            <option value="Аптека / Медицина">💊 Аптека / Медицина</option>
                            <option value="Послуги / Краса">✂️ Послуги / Краса</option>
                            <option value="Офіс / Відділення">🏢 Офіс / Відділення</option>
                            <option value="Інше">📦 Інше</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => bulkModel.BusinessCategory)" class="text-danger small" />
                    </div>
                    
                    <div class="col-md-6">
                        @if (bulkModel.IsNetwork)
                        {
                            <label class="form-label fw-bold text-primary">Загальна назва мережі</label>
                            <InputText class="form-control border-primary" @bind-Value="bulkModel.NetworkName" placeholder="Напр. 'Нова Пошта' або 'АТБ'" />
                        }
                        else
                        {
                            <label class="form-label fw-bold">Назва закладу (Вивіска)</label>
                            <InputText class="form-control" @bind-Value="bulkModel.NetworkName" placeholder="Напр. Кав'ярня 'У Ані'" />
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Короткий загальний опис послуг</label>
                        <InputTextArea class="form-control" @bind-Value="bulkModel.GeneralDescription" rows="2" placeholder="Що ви пропонуєте містянам?"></InputTextArea>
                    </div>

                    <div class="col-md-6">
                        <div class="form-check form-switch mt-2">
                            <InputCheckbox class="form-check-input" id="isIncl" @bind-Value="bulkModel.IsInclusive" />
                            <label class="form-check-label fw-bold" for="isIncl"><i class="bi bi-person-wheelchair"></i> Безбар'єрний доступ</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <InputText class="form-control form-control-sm" @bind-Value="bulkModel.ReferenceLink" placeholder="Веб-сайт або соцмережа (опціонально)" />
                    </div>

                    <div class="col-12 mt-3">
                        <div class="border rounded p-3 bg-white">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <label class="fw-bold mb-0">Графік роботи</label>
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox" class="form-check-input" id="is247" @bind="is24_7" />
                                    <label class="form-check-label text-success fw-bold" for="is247">Цілодобово (24/7)</label>
                                </div>
                            </div>
                            @if (!is24_7)
                            {
                                <div class="row g-2">
                                    @foreach (var day in daysOfWeek)
                                    {
                                        if (weeklySchedule.TryGetValue(day, out var schedule))
                                        {
                                            <div class="col-md-6 col-lg-4">
                                                <div class="d-flex align-items-center border rounded p-1">
                                                    <div style="width: 35px;" class="fw-bold text-center @(schedule.IsWorking ? "text-dark" : "text-muted")">@day</div>
                                                    <div class="form-check form-switch ms-1 me-2 mb-0">
                                                        <input type="checkbox" class="form-check-input" @bind="schedule.IsWorking" />
                                                    </div>
                                                    @if (schedule.IsWorking)
                                                    {
                                                        <input type="time" class="form-control form-control-sm px-1 text-center" @bind="schedule.Open" />
                                                        <span class="mx-1">-</span>
                                                        <input type="time" class="form-control form-control-sm px-1 text-center" @bind="schedule.Close" />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted fst-italic flex-grow-1 text-center small">Вихідний</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none mt-2" @onclick="CopyMondayToWeekdays">
                                    <i class="bi bi-files"></i> Скопіювати час Пн на Вт-Пт
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt-fill text-danger"></i> Локації (Адреси)</h5>
            
            @foreach (var (branch, index) in bulkModel.Branches.Select((b, i) => (b, i)))
            {
                <div class="card shadow-sm border-0 mb-3 border-start border-4 border-warning">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                        <span class="fw-bold">Адреса @(bulkModel.IsNetwork ? $"відділення #{index + 1}" : "закладу")</span>
                        @if (bulkModel.IsNetwork && bulkModel.Branches.Count > 1)
                        {
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveBranch(branch)"><i class="bi bi-trash"></i></button>
                        }
                    </div>
                    <div class="card-body row g-3">
                        <div class="col-md-12 position-relative">
                            <label class="form-label fw-bold small">Вулиця <span class="text-danger">*</span></label>
                            <input type="text" class="form-control @(branch.StreetId == 0 ? "border-warning" : "is-valid")"
                                   value="@branch.StreetSearchQuery"
                                   @oninput="(e) => SearchStreet(e, branch)"
                                   placeholder="Почніть вводити назву вулиці..." autocomplete="off" />
                            
                            @if (branch.StreetSuggestions.Any())
                            {
                                <ul class="list-group position-absolute w-100 shadow mt-1" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                                    @foreach (var s in branch.StreetSuggestions)
                                    {
                                        <li class="list-group-item list-group-item-action text-primary" style="cursor: pointer;" @onclick="() => SelectStreet(s, branch)">
                                            @s.DisplayName
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">Будинок / Літера / Корп <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <InputNumber class="form-control" @bind-Value="branch.BuildingNumber" placeholder="№" />
                                <span class="input-group-text">-</span>
                                <InputText class="form-control" @bind-Value="branch.BuildingLetter" placeholder="Літ(А)" />
                                <span class="input-group-text">корп.</span>
                                <InputText class="form-control" @bind-Value="branch.BuildingBlock" placeholder="Корп." />
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold small">№ приміщення</label>
                            <InputText class="form-control" @bind-Value="branch.PremiseNumber" placeholder="Кв. / Офіс" />
                        </div>

                        @if (bulkModel.IsNetwork)
                        {
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">Уточнення назви (опціонально)</label>
                                <InputText class="form-control form-control-sm border-primary" @bind-Value="branch.LocalName" placeholder="напр. Відділення №5" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">Індивідуальний опис (опціонально)</label>
                                <InputText class="form-control form-control-sm" @bind-Value="branch.Description" placeholder="напр. Вантажне відділення до 1000 кг" />
                            </div>
                        }
                    </div>
                </div>
            }

            @if (bulkModel.IsNetwork)
            {
                <button type="button" class="btn btn-outline-primary mb-4 w-100 fw-bold" style="border-style: dashed;" @onclick="AddBranch">
                    <i class="bi bi-plus-circle"></i> Додати ще одну адресу (відділення)
                </button>
            }

            @if (!string.IsNullOrEmpty(serverError))
            {
                <div class="alert alert-danger p-2 mb-3">@serverError</div>
            }

            <div class="text-end">
                <button type="submit" class="btn btn-warning btn-lg fw-bold px-5 rounded-pill shadow-sm" disabled="@isSubmitting">
                    @if (isSubmitting) { <span class="spinner-border spinner-border-sm"></span> }
                    else { <span><i class="bi bi-send-fill"></i> Відправити заявку</span> }
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    public class BulkRequestModel
    {
        [Required(ErrorMessage = "Введіть ЄДРПОУ або ІПН")] public string Edrpou { get; set; } = "";
        [Required(ErrorMessage = "Введіть юридичну назву")] public string LegalName { get; set; } = "";
        [Required(ErrorMessage = "Введіть контакт")] public string ContactInfo { get; set; } = "";
        [Required(ErrorMessage = "Оберіть сферу")] public string BusinessCategory { get; set; } = "";
        public bool IsNetwork { get; set; }
        public string? NetworkName { get; set; }
        public string? GeneralDescription { get; set; }
        public bool IsInclusive { get; set; }
        public string? ReferenceLink { get; set; }
        public string? WorkingHours { get; set; }
        public List<BranchModel> Branches { get; set; } = new() { new BranchModel() };
    }

    public class BranchModel
    {
        public string? LocalName { get; set; }
        public string? Description { get; set; }
        public int StreetId { get; set; }
        public int BuildingNumber { get; set; }
        public string? BuildingLetter { get; set; }
        public string? BuildingBlock { get; set; }
        public string? PremiseNumber { get; set; }
        public string StreetSearchQuery { get; set; } = "";
        public List<CityCrm.AdminUI.Models.Street> StreetSuggestions { get; set; } = new();
    }

    private BulkRequestModel bulkModel = new();
    private bool isSubmitted = false;
    private bool isSubmitting = false;
    private string serverError = "";
    private string submittedTrackingNumber = "";

    private bool is24_7 = false;
    private readonly string[] daysOfWeek = { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Нд" };
    private Dictionary<string, DaySchedule> weeklySchedule = new();

    private string trackingId = "";
    private TrackingResponse? trackingResult;
    private string trackingError = "";
    private bool isCheckingStatus = false;

    public class DaySchedule { public bool IsWorking { get; set; } = true; public TimeOnly? Open { get; set; } = new TimeOnly(9, 0); public TimeOnly? Close { get; set; } = new TimeOnly(18, 0); }
    public class TrackingResponse { public string TrackingNumber { get; set; } = ""; public string Name { get; set; } = ""; public List<BranchStatus> Branches { get; set; } = new(); }
    public class BranchStatus { public string Name { get; set; } = ""; public string Address { get; set; } = ""; public string Status { get; set; } = ""; }

    protected override void OnInitialized() => ResetForm();

    private void ResetForm()
    {
        bulkModel = new BulkRequestModel();
        isSubmitted = false;
        is24_7 = false;
        submittedTrackingNumber = "";
        weeklySchedule = daysOfWeek.ToDictionary(d => d, d => new DaySchedule { IsWorking = d != "Сб" && d != "Нд" });
    }

    private void OnNetworkToggleAfter()
    {
        if (!bulkModel.IsNetwork && bulkModel.Branches.Count > 1)
        {
            var first = bulkModel.Branches.First();
            bulkModel.Branches.Clear();
            bulkModel.Branches.Add(first);
        }
    }

    private void AddBranch() => bulkModel.Branches.Add(new BranchModel());
    private void RemoveBranch(BranchModel b) => bulkModel.Branches.Remove(b);

    private async Task SearchStreet(ChangeEventArgs e, BranchModel branch)
    {
        branch.StreetSearchQuery = e.Value?.ToString() ?? "";
        branch.StreetId = 0;

        if (branch.StreetSearchQuery.Length >= 2)
        {
            var result = await Http.GetFromJsonAsync<List<CityCrm.AdminUI.Models.Street>>($"api/streets/search?q={branch.StreetSearchQuery}");
            if (result != null) branch.StreetSuggestions = result;
        }
        else branch.StreetSuggestions.Clear();
    }

    private void SelectStreet(CityCrm.AdminUI.Models.Street street, BranchModel branch)
    {
        branch.StreetId = street.Id;
        branch.StreetSearchQuery = street.DisplayName;
        branch.StreetSuggestions.Clear();
    }

    private void CopyMondayToWeekdays()
    {
        if (weeklySchedule.TryGetValue("Пн", out var mon) && mon.IsWorking)
        {
            foreach (var day in new[] { "Вт", "Ср", "Чт", "Пт" })
            {
                if (weeklySchedule.TryGetValue(day, out var target))
                {
                    target.IsWorking = true; target.Open = mon.Open; target.Close = mon.Close;
                }
            }
        }
    }

    private async Task CheckStatus()
    {
        if (string.IsNullOrWhiteSpace(trackingId)) return;
        isCheckingStatus = true; trackingError = ""; trackingResult = null;
        try
        {
            var response = await Http.GetAsync($"api/businessrequests/tracking/{trackingId.Trim()}");
            if (response.IsSuccessStatusCode) trackingResult = await response.Content.ReadFromJsonAsync<TrackingResponse>();
            else trackingError = "Заявку з таким номером не знайдено.";
        }
        catch { trackingError = "Помилка з'єднання з сервером."; }
        finally { isCheckingStatus = false; }
    }

    private async Task HandleTrackingEnter(KeyboardEventArgs e) { if (e.Key == "Enter") await CheckStatus(); }

    private string GetStatusText(string status) => status switch { "Pending" => "В обробці", "Approved" => "Опубліковано", "Rejected" => "Відхилено", _ => "Невідомо" };
    private string GetStatusAlertClass(string status) => status switch { "Pending" => "bg-warning text-dark", "Approved" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
    private string GetStatusIconClass(string status) => status switch { "Pending" => "bi-hourglass-split", "Approved" => "bi-check-circle", "Rejected" => "bi-x-circle", _ => "bi-question-circle" };

    private async Task SubmitRequest()
    {
        serverError = "";
        
        if (string.IsNullOrWhiteSpace(bulkModel.NetworkName))
        {
            serverError = bulkModel.IsNetwork ? "Заповніть назву мережі." : "Заповніть назву закладу.";
            return;
        }

        if (bulkModel.Branches.Any(b => b.StreetId == 0 || b.BuildingNumber <= 0))
        {
            serverError = "У всіх адрес має бути обрана вулиця з довідника та вказаний номер будинку.";
            return;
        }

        isSubmitting = true;

        if (is24_7)
        {
            foreach (var day in daysOfWeek)
            {
                weeklySchedule[day].IsWorking = true;
                weeklySchedule[day].Open = new TimeOnly(0, 0);
                weeklySchedule[day].Close = new TimeOnly(23, 59);
            }
        }
        bulkModel.WorkingHours = System.Text.Json.JsonSerializer.Serialize(weeklySchedule);

        try
        {
            var response = await Http.PostAsJsonAsync("api/businessrequests", bulkModel);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Dictionary<string, object>>();
                if (result != null && result.ContainsKey("trackingNumber"))
                    submittedTrackingNumber = result["trackingNumber"].ToString()!;
                isSubmitted = true;
            }
            else serverError = "Помилка при відправці на сервер. Спробуйте пізніше.";
        }
        catch { serverError = "Помилка з'єднання з сервером."; }
        finally { isSubmitting = false; }
    }
}