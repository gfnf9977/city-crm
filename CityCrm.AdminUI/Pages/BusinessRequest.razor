@page "/business-request"
@using CityCrm.AdminUI.Models
@inject HttpClient Http

<PageTitle>Відповідальний бізнес | CityCrm</PageTitle>

<div class="container py-4" style="max-width: 850px;">
    <h2 class="fw-bold text-dark mb-3"><i class="bi bi-shop text-warning"></i> Додати бізнес на карту міста</h2>
    <p class="text-muted mb-4">
        Заповніть форму нижче, щоб додати ваш заклад до міського реєстру. Після перевірки модератором, він з'явиться на публічній карті Чернігова.
    </p>

    <div class="card bg-light border-0 shadow-sm mb-4">
        <div class="card-body p-3 d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-search fs-3 text-primary me-3"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Перевірити статус заявки</h6>
                    <small class="text-muted">Введіть трекінг-номер, який ви отримали раніше</small>
                </div>
            </div>
            <div class="input-group" style="max-width: 300px;">
                <input type="number" class="form-control" placeholder="Номер заявки..." @bind="trackingId" @bind:event="oninput" @onkeyup="HandleTrackingEnter" />
                <button class="btn btn-primary" @onclick="CheckStatus">
                    @if (isCheckingStatus) { <span class="spinner-border spinner-border-sm"></span> }
                    else { <span>Перевірити</span> }
                </button>
            </div>
        </div>
        
        @if (trackingResult != null)
        {
            <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                <div class="alert @GetStatusAlertClass(trackingResult.Status) mb-0 py-2 d-flex align-items-center">
                    <i class="bi @GetStatusIconClass(trackingResult.Status) fs-5 me-2"></i>
                    <div>
                        <strong>Заявка #@trackingResult.Id</strong> — @trackingResult.Name
                        <br/>
                        Статус: <strong>@GetStatusText(trackingResult.Status)</strong>
                    </div>
                </div>
            </div>
        }
        @if (!string.IsNullOrEmpty(trackingError))
        {
            <div class="card-footer bg-white border-top-0 pt-0 pb-3">
                <div class="text-danger small fw-bold"><i class="bi bi-exclamation-triangle"></i> @trackingError</div>
            </div>
        }
    </div>

    @if (isSubmitted)
    {
        <div class="alert alert-success shadow-sm p-5 text-center border-0" style="background-color: #e6ffe6;">
            <i class="bi bi-check-circle-fill text-success display-1 d-block mb-3"></i>
            <h3 class="fw-bold">Заявку успішно прийнято!</h3>
            <p class="fs-5 mb-2">Ваш номер для відстеження:</p>
            <div class="display-4 fw-bold text-success mb-4" style="letter-spacing: 2px;">#@submittedRequestId</div>
            <p class="text-muted mb-4">Збережіть цей номер. Ви зможете перевірити статус обробки заявки на цій же сторінці.</p>
            <button class="btn btn-success px-4 rounded-pill" @onclick="ResetForm">Подати ще одну заявку</button>
        </div>
    }
    else
    {
        <EditForm Model="requestModel" OnValidSubmit="SubmitRequest">
            <DataAnnotationsValidator />

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold text-secondary">
                    <i class="bi bi-file-earmark-person"></i> Юридична інформація (Конфіденційно)
                </div>
                <div class="card-body row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-bold">ЄДРПОУ / ІПН</label>
                        <InputText class="form-control" @bind-Value="requestModel.Edrpou" placeholder="12345678" />
                        <ValidationMessage For="@(() => requestModel.Edrpou)" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Офіційна назва ФОП/ТОВ</label>
                        <InputText class="form-control" @bind-Value="requestModel.LegalName" placeholder="ТОВ 'Сільпо'" />
                        <ValidationMessage For="@(() => requestModel.LegalName)" class="text-danger small" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Контакт (Телефон/Email)</label>
                        <InputText class="form-control" @bind-Value="requestModel.ContactInfo" placeholder="Для модератора" />
                        <ValidationMessage For="@(() => requestModel.ContactInfo)" class="text-danger small" />
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold text-secondary">
                    <i class="bi bi-shop"></i> Публічні дані закладу
                </div>
                <div class="card-body row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Сфера діяльності</label>
                        <InputSelect class="form-select" @bind-Value="requestModel.BusinessCategory">
                            <option value="">Оберіть категорію...</option>
                            <option value="Продукти / Супермаркет">🛒 Продукти / Супермаркет</option>
                            <option value="Кафе / Ресторан">☕ Кафе / Ресторан</option>
                            <option value="СТО / Автомийка">🔧 СТО / Автомийка</option>
                            <option value="Аптека / Медицина">💊 Аптека / Медицина</option>
                            <option value="Послуги / Краса">✂️ Послуги / Краса</option>
                            <option value="Офіс / Відділення">🏢 Офіс / Відділення</option>
                            <option value="Інше">📦 Інше</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => requestModel.BusinessCategory)" class="text-danger small" />
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Назва закладу (вивіска)</label>
                        <InputText class="form-control" @bind-Value="requestModel.LocalName" placeholder="Напр: Кав'ярня 'У Ані'" />
                        <ValidationMessage For="@(() => requestModel.LocalName)" class="text-danger small" />
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox class="form-check-input" id="isNet" @bind-Value="requestModel.IsNetwork" />
                            <label class="form-check-label fw-bold text-primary" for="isNet">Це мережевий заклад (супермаркет, пошта, банк)?</label>
                        </div>
                        @if (requestModel.IsNetwork)
                        {
                            <InputText class="form-control border-primary" @bind-Value="requestModel.NetworkName" placeholder="Назва мережі (напр. 'Нова Пошта' або 'АТБ')" />
                            <div class="form-text">Ми автоматично об'єднаємо назву мережі з назвою відділення.</div>
                        }
                    </div>

                    <div class="col-12">
                        <label class="form-label fw-bold">Короткий опис</label>
                        <InputTextArea class="form-control" @bind-Value="requestModel.Description" rows="2" placeholder="Що ви пропонуєте містянам?"></InputTextArea>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold text-secondary">
                    <i class="bi bi-geo-alt"></i> Адреса розташування
                </div>
                <div class="card-body row g-3">
                    <div class="col-12 position-relative">
                        <label class="form-label fw-bold">Вулиця</label>
                        <input type="text" class="form-control @(requestModel.StreetId == 0 ? "border-warning" : "is-valid")"
                               @bind="streetSearchQuery"
                               @oninput="SearchStreet"
                               placeholder="Почніть вводити назву вулиці..."
                               autocomplete="off" />
                        <ValidationMessage For="@(() => requestModel.StreetId)" class="text-danger small" />

                        @if (streetSuggestions.Any())
                        {
                            <ul class="list-group position-absolute w-100 shadow mt-1" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                                @foreach (var s in streetSuggestions)
                                {
                                    <li class="list-group-item list-group-item-action text-primary" style="cursor: pointer;" @onclick="() => SelectStreet(s)">
                                        @s.DisplayName
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Будинок / Літера / Корпус</label>
                        <div class="input-group">
                            <InputNumber class="form-control" @bind-Value="requestModel.BuildingNumber" placeholder="№" />
                            <span class="input-group-text">-</span>
                            <InputText class="form-control" @bind-Value="requestModel.BuildingLetter" placeholder="Літера (А)" />
                            <span class="input-group-text">корп.</span>
                            <InputText class="form-control" @bind-Value="requestModel.BuildingBlock" placeholder="Корп." />
                        </div>
                        <ValidationMessage For="@(() => requestModel.BuildingNumber)" class="text-danger small" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">№ приміщення (якщо є)</label>
                        <InputText class="form-control" @bind-Value="requestModel.PremiseNumber" placeholder="Кв. / Офіс / Бутік" />
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light fw-bold text-secondary">
                    <i class="bi bi-info-circle"></i> Додаткові деталі
                </div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <InputCheckbox class="form-check-input" id="isIncl" @bind-Value="requestModel.IsInclusive" />
                        <label class="form-check-label fw-bold text-primary" for="isIncl"><i class="bi bi-person-wheelchair"></i> Безбар'єрний доступ (наявний пандус / рівний вхід)</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Посилання на об'єкт для верифікації</label>
                        <InputText class="form-control" @bind-Value="requestModel.ReferenceLink" placeholder="Посилання на Google Maps, Instagram закладу або фото фасаду" />
                        <ValidationMessage For="@(() => requestModel.ReferenceLink)" class="text-danger small" />
                    </div>

                    <div class="border rounded p-3 bg-white">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <label class="fw-bold mb-0">Графік роботи</label>
                            <div class="form-check form-switch mb-0">
                                <input type="checkbox" class="form-check-input" id="is247" @bind="is24_7" />
                                <label class="form-check-label text-success fw-bold" for="is247">Цілодобово (24/7)</label>
                            </div>
                        </div>

                        @if (!is24_7)
                        {
                            <div class="row g-2">
                                @foreach (var day in daysOfWeek)
                                {
                                    if (weeklySchedule.TryGetValue(day, out var schedule))
                                    {
                                        <div class="col-md-6 col-lg-4">
                                            <div class="d-flex align-items-center border rounded p-1">
                                                <div style="width: 35px;" class="fw-bold text-center @(schedule.IsWorking ? "text-dark" : "text-muted")">@day</div>
                                                <div class="form-check form-switch ms-1 me-2 mb-0">
                                                    <input type="checkbox" class="form-check-input" @bind="schedule.IsWorking" />
                                                </div>
                                                @if (schedule.IsWorking)
                                                {
                                                    <input type="time" class="form-control form-control-sm px-1 text-center" @bind="schedule.Open" />
                                                    <span class="mx-1">-</span>
                                                    <input type="time" class="form-control form-control-sm px-1 text-center" @bind="schedule.Close" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic flex-grow-1 text-center small">Вихідний</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <button type="button" class="btn btn-sm btn-link text-decoration-none mt-2" @onclick="CopyMondayToWeekdays">
                                <i class="bi bi-files"></i> Скопіювати час Пн на Вт-Пт
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(serverError))
            {
                <div class="alert alert-danger p-2 mb-3">@serverError</div>
            }

            <div class="text-end">
                <button type="submit" class="btn btn-warning btn-lg fw-bold px-5 rounded-pill shadow-sm" disabled="@isSubmitting">
                    @if (isSubmitting) { <span class="spinner-border spinner-border-sm"></span> }
                    else { <span><i class="bi bi-send-fill"></i> Відправити заявку</span> }
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    private BusinessRequestModel requestModel = new();
    private bool isSubmitted = false;
    private bool isSubmitting = false;
    private string serverError = "";
    private int submittedRequestId = 0;

    private string streetSearchQuery = "";
    private List<Street> streetSuggestions = new();

    private bool is24_7 = false;
    private readonly string[] daysOfWeek = { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Нд" };
    private Dictionary<string, DaySchedule> weeklySchedule = new();

    private int? trackingId;
    private TrackingResponse? trackingResult;
    private string trackingError = "";
    private bool isCheckingStatus = false;

    public class DaySchedule
    {
        public bool IsWorking { get; set; } = true;
        public TimeOnly? Open { get; set; } = new TimeOnly(9, 0);
        public TimeOnly? Close { get; set; } = new TimeOnly(18, 0);
    }

    public class CreateResponse { public int Id { get; set; } }
    public class TrackingResponse { public int Id { get; set; } public string Status { get; set; } = ""; public string Name { get; set; } = ""; }

    protected override void OnInitialized()
    {
        ResetForm();
    }

    private void ResetForm()
    {
        requestModel = new BusinessRequestModel();
        streetSearchQuery = "";
        isSubmitted = false;
        is24_7 = false;
        submittedRequestId = 0;
        weeklySchedule = daysOfWeek.ToDictionary(d => d, d => new DaySchedule { IsWorking = d != "Сб" && d != "Нд" });
    }

    private async Task SearchStreet(ChangeEventArgs e)
    {
        streetSearchQuery = e.Value?.ToString() ?? "";
        requestModel.StreetId = 0;

        if (streetSearchQuery.Length >= 2)
        {
            var result = await Http.GetFromJsonAsync<List<Street>>($"api/streets/search?q={streetSearchQuery}");
            if (result != null) streetSuggestions = result;
        }
        else
        {
            streetSuggestions.Clear();
        }
    }

    private void SelectStreet(Street street)
    {
        requestModel.StreetId = street.Id;
        streetSearchQuery = street.DisplayName;
        streetSuggestions.Clear();
    }

    private void CopyMondayToWeekdays()
    {
        if (weeklySchedule.TryGetValue("Пн", out var mon) && mon.IsWorking)
        {
            string[] weekdays = { "Вт", "Ср", "Чт", "Пт" };
            foreach (var day in weekdays)
            {
                if (weeklySchedule.TryGetValue(day, out var target))
                {
                    target.IsWorking = true;
                    target.Open = mon.Open;
                    target.Close = mon.Close;
                }
            }
        }
    }

    private async Task CheckStatus()
    {
        if (trackingId == null || trackingId <= 0) return;
        
        isCheckingStatus = true;
        trackingError = "";
        trackingResult = null;

        try
        {
            var response = await Http.GetAsync($"api/businessrequests/{trackingId}/status");
            if (response.IsSuccessStatusCode)
            {
                trackingResult = await response.Content.ReadFromJsonAsync<TrackingResponse>();
            }
            else
            {
                trackingError = "Заявку з таким номером не знайдено.";
            }
        }
        catch
        {
            trackingError = "Помилка з'єднання з сервером.";
        }
        finally
        {
            isCheckingStatus = false;
        }
    }

    private async Task HandleTrackingEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CheckStatus();
    }

    private string GetStatusText(string status) => status switch {
        "Pending" => "Очікує модерації (В обробці)",
        "Approved" => "Схвалено та опубліковано на карті",
        "Rejected" => "Відхилено модератором (Спам або помилка)",
        _ => "Невідомо"
    };

    private string GetStatusAlertClass(string status) => status switch {
        "Pending" => "alert-warning text-dark border-warning",
        "Approved" => "alert-success border-success",
        "Rejected" => "alert-danger border-danger",
        _ => "alert-secondary"
    };

    private string GetStatusIconClass(string status) => status switch {
        "Pending" => "bi-hourglass-split",
        "Approved" => "bi-check-circle-fill",
        "Rejected" => "bi-x-circle-fill",
        _ => "bi-question-circle"
    };

    private async Task SubmitRequest()
    {
        serverError = "";

        if (requestModel.StreetId == 0)
        {
            serverError = "Будь ласка, оберіть вулицю з випадаючого списку.";
            return;
        }

        isSubmitting = true;

        if (is24_7)
        {
            foreach (var day in daysOfWeek)
            {
                weeklySchedule[day].IsWorking = true;
                weeklySchedule[day].Open = new TimeOnly(0, 0);
                weeklySchedule[day].Close = new TimeOnly(23, 59);
            }
        }
        requestModel.WorkingHours = System.Text.Json.JsonSerializer.Serialize(weeklySchedule);

        try
        {
            var response = await Http.PostAsJsonAsync("api/businessrequests", requestModel);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<CreateResponse>();
                if (result != null)
                {
                    submittedRequestId = result.Id;
                }
                isSubmitted = true;
            }
            else
            {
                serverError = "Помилка при відправці на сервер. Спробуйте пізніше.";
            }
        }
        catch
        {
            serverError = "Помилка з'єднання з сервером.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}