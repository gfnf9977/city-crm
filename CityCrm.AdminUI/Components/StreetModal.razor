@using CityCrm.AdminUI.Models
@inject HttpClient Http

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(Model.Id == 0 ? "Додати вулицю" : "Редагувати вулицю")</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger p-2 mb-3">@errorMessage</div>
                    }

                    <EditForm Model="Model" OnSubmit="Save">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />
                        
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Тип</label>
                                <InputSelect class="form-select" @bind-Value="Model.StreetType">
                                    <option value="вул.">вул.</option>
                                    <option value="просп.">просп.</option>
                                    <option value="пров.">пров.</option>
                                    <option value="бульв.">бульв.</option>
                                    <option value="площа">площа</option>
                                    <option value="узв.">узв.</option>
                                    <option value="шосе">шосе</option>
                                    <option value="тупик">тупик</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Назва (без типу)</label>
                                <InputText class="form-control" @bind-Value="Model.Name" required placeholder="Наприклад: Миру" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Колишні назви (через кому)</label>
                            <InputText class="form-control" @bind-Value="Model.OldNames" placeholder="Напр: Леніна, Радянська" />
                            <div class="form-text">Це допоможе знаходити вулицю за старими назвами.</div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="button" class="btn btn-secondary me-2" @onclick="Close">Скасувати</button>
                            <button type="submit" class="btn btn-primary">Зберегти</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Street Model { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private string errorMessage = "";

    private async Task Save()
    {
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(Model.Name))
        {
            errorMessage = "Назва вулиці є обов'язковою.";
            return;
        }

        var response = Model.Id == 0
            ? await Http.PostAsJsonAsync("api/streets", Model)
            : await Http.PutAsJsonAsync($"api/streets/{Model.Id}", Model);

        if (response.IsSuccessStatusCode)
        {
            await OnSaved.InvokeAsync();
        }
        else
        {
            errorMessage = "Сервер відхилив запит. Спробуйте ще раз.";
        }
    }

    private async Task Close()
    {
        errorMessage = "";
        await OnClosed.InvokeAsync();
    }
}