@using CityCrm.AdminUI.Models
@inject HttpClient Http
@inject IJSRuntime JS

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Будівля</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="Model" OnSubmit="Save">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />
                        <div class="mb-3">
                            <label class="fw-bold">Тип забудови</label>
                            <InputSelect class="form-select" @bind-Value="Model.BuildingType">
                                <option value="Багатоповерхівка">Багатоповерхівка (Житлова)</option>
                                <option value="Офісний/Бізнес центр">Офісний/Бізнес центр</option>
                                <option value="Громадська будівля">Громадська будівля (Школа, Лікарня)</option>
                                <option value="Приватний будинок">Приватний будинок</option>
                                <option value="Комерційна забудова">Комерційна забудова (Готель / Офіс / ТЦ)</option>
                                <option value="Промисловий/Складський об'єкт">Промисловий/Складський об'єкт</option>
                                <option value="Гаражний кооператив">Гаражний кооператив</option>
                                <option value="Гуртожиток">Гуртожиток</option>
                            </InputSelect>
                        </div>

                        <div class="card p-3 mb-3 bg-light border-0 shadow-sm">
                            @if (Model.BuildingType == "Гаражний кооператив")
                            {
                                <div class="mb-3">
                                    <label class="fw-bold text-primary">Номер кооперативу (АК №)</label>
                                    <InputText class="form-control border-primary" @bind-Value="Model.CoopNumber" placeholder="Наприклад: 27" />
                                </div>
                            }

                            <div class="mb-3 position-relative">
                                <label class="fw-bold">Вулиця</label>
                                <input type="text" class="form-control"
                                       @bind="streetSearchQuery"
                                       @oninput="SearchStreet"
                                       placeholder="Почніть вводити назву (напр. Рокос...)"
                                       autocomplete="off" />

                                @if (streetSuggestions.Any())
                                {
                                    <ul class="list-group position-absolute w-100 shadow-lg mt-1" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                                        @foreach (var s in streetSuggestions)
                                        {
                                            <li class="list-group-item list-group-item-action text-primary"
                                                style="cursor: pointer;"
                                                @onclick="() => SelectStreet(s)">
                                                <i class="bi bi-geo-alt me-2"></i> @s.DisplayName
                                            </li>
                                        }
                                    </ul>
                                }

                                @if (!string.IsNullOrEmpty(Model.StreetName))
                                {
                                    <div class="form-text text-success">
                                        <i class="bi bi-check-circle"></i> Обрано: @Model.StreetType @Model.StreetName
                                    </div>
                                }
                            </div>

                            <div class="row">
                                <div class="col-12">
                                    <label>Номер / Літера / Корпус</label>
                                    <div class="input-group mb-1">
                                        <InputNumber class="form-control" style="max-width: 90px;" @bind-Value="Model.BuildingNumber" placeholder="15" />
                                        <span class="input-group-text">-</span>
                                        <InputText class="form-control" style="max-width: 70px;" @bind-Value="Model.BuildingLetter" placeholder="А" title="Літера" />
                                        <span class="input-group-text">корп.</span>
                                        <InputText class="form-control" style="max-width: 80px;" @bind-Value="Model.BuildingBlock" placeholder="3" title="Корпус" />

                                        <button type="button" class="btn btn-outline-primary fw-bold" @onclick="FetchOsmContour" disabled="@isFetchingOsm">
                                            @if (isFetchingOsm) { <span class="spinner-border spinner-border-sm"></span> }
                                            else { <span>🪄 Контур</span> }
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(osmMessage))
                                    {
                                        <small class="text-info fw-bold">@osmMessage</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label>Технічний стан</label>
                            <InputSelect class="form-select" @bind-Value="Model.Condition">
                                <option value="В експлуатації">В експлуатації (Нормальний)</option>
                                <option value="В процесі будівництва">В процесі будівництва</option>
                                <option value="Зруйновано (бойові дії)">Зруйновано (бойові дії)</option>
                                <option value="Занедбана будівля">Занедбана будівля (Покинуто)</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Примітки (опціонально)</label>
                            <InputTextArea class="form-control" @bind-Value="Model.Notes" rows="2" placeholder="Особливості об'єкта, пошкодження тощо..." />
                        </div>

                        <div class="mb-3">
                            <label class="fw-bold">Клікніть на карті, щоб вказати розташування:</label>
                            <div id="mapPicker" style="height: 450px; width: 100%; border-radius: 8px; border: 1px solid #ccc; z-index: 1000;"></div>

                            @if (Model.Lat != 0)
                            {
                                <small class="text-success"><i class="bi bi-geo-alt-fill"></i> Точку зафіксовано: @Model.Lat, @Model.Lng</small>
                            }
                            else
                            {
                                <small class="text-danger"><i class="bi bi-exclamation-triangle"></i> Розташування не обрано!</small>
                            }
                        </div>

                        <div class="text-end">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Скасувати</button>
                            <button type="submit" class="btn btn-primary">Зберегти</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private class CoordinatesDto
    {
        public double Lat { get; set; }
        public double Lng { get; set; }
    }

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Building Model { get; set; } = new();
    [Parameter] public List<Building> OtherBuildings { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private string streetSearchQuery = "";
    private List<Street> streetSuggestions = new();
    private DotNetObjectReference<BuildingModal>? objRef;
    private bool isFetchingOsm = false;
    private string osmMessage = "";
    private bool mapInitialized = false;

    protected override void OnInitialized()
    {
        objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !mapInitialized)
        {
            streetSearchQuery = string.IsNullOrEmpty(Model.StreetName)
                ? ""
                : $"{Model.StreetType} {Model.StreetName}";
            streetSuggestions.Clear();
            osmMessage = "";
            mapInitialized = true;

            await Task.Delay(100);

            var otherPolygons = OtherBuildings
                .Where(x => x.Id != Model.Id && !string.IsNullOrEmpty(x.GeoJson))
                .Select(x => x.GeoJson)
                .ToList();

            await JS.InvokeVoidAsync("initMapPicker", Model.Lat, Model.Lng, objRef, otherPolygons);

            if (!string.IsNullOrEmpty(Model.GeoJson))
            {
                await JS.InvokeVoidAsync("drawOsmPolygon", Model.GeoJson);
            }
        }
        else if (!IsVisible)
        {
            mapInitialized = false;
        }
    }

    [JSInvokable]
    public void SetPickedCoordinates(double lat, double lng)
    {
        Model.Lat = lat;
        Model.Lng = lng;
        Model.GeoJson = null;
        StateHasChanged();
    }

    [JSInvokable]
    public void SetDrawnGeoJson(string? geoJsonStr)
    {
        Model.GeoJson = geoJsonStr;
        Model.Lat = 0;
        Model.Lng = 0;
        StateHasChanged();
    }

    private async Task SearchStreet(ChangeEventArgs e)
    {
        streetSearchQuery = e.Value?.ToString() ?? "";

        if (streetSearchQuery.Length >= 2)
        {
            var result = await Http.GetFromJsonAsync<List<Street>>($"api/streets/search?q={streetSearchQuery}");
            if (result != null) streetSuggestions = result;
        }
        else
        {
            streetSuggestions.Clear();
        }
    }

    private void SelectStreet(Street street)
    {
        Model.StreetType = street.StreetType;
        Model.StreetName = street.Name;
        streetSearchQuery = street.DisplayName;
        streetSuggestions.Clear();
    }

    private async Task FetchOsmContour()
    {
        if (string.IsNullOrWhiteSpace(Model.StreetName) || Model.BuildingNumber <= 0)
        {
            osmMessage = "Спочатку оберіть вулицю та вкажіть коректний номер будинку!";
            return;
        }

        isFetchingOsm = true;
        osmMessage = "📡 Шукаємо контур будівлі в OSM...";
        StateHasChanged();

        bool contourFound = false;
        string fullNumber = $"{Model.BuildingNumber}{Model.BuildingLetter?.Trim()}";

        try
        {
            var response = await Http.GetAsync($"api/buildings/osm-contour?street={Model.StreetName}&number={Uri.EscapeDataString(fullNumber)}");

            if (response.IsSuccessStatusCode)
            {
                var geoJson = await response.Content.ReadAsStringAsync();
                Model.GeoJson = geoJson;
                Model.Lat = 0;
                Model.Lng = 0;
                osmMessage = "✨ Контур знайдено і побудовано!";
                await JS.InvokeVoidAsync("drawOsmPolygon", geoJson);
                contourFound = true;
            }
        }
        catch { }

        if (!contourFound)
        {
            osmMessage = "🔍 Контур не знайдено. Шукаємо координати будинку...";
            StateHasChanged();

            try
            {
                var geoResponse = await Http.GetAsync($"api/streets/geocode?street={Model.StreetName}&number={Uri.EscapeDataString(fullNumber)}");
                if (geoResponse.IsSuccessStatusCode)
                {
                    var coords = await geoResponse.Content.ReadFromJsonAsync<CoordinatesDto>();
                    if (coords != null)
                    {
                        await JS.InvokeVoidAsync("centerMapPicker", coords.Lat, coords.Lng);
                        osmMessage = "📍 Контур відсутній, але ми відцентрували карту на цій адресі. Намалюйте об'єкт вручну (кнопка ⬟).";
                    }
                }
                else
                {
                    osmMessage = "❌ Будівлю не знайдено взагалі. Знайдіть її на карті та намалюйте контур вручну (кнопка ⬟).";
                }
            }
            catch
            {
                osmMessage = "❌ Будівлю не знайдено. Намалюйте контур вручну (кнопка ⬟).";
            }
        }

        isFetchingOsm = false;
        StateHasChanged();
    }

    private async Task Save()
    {
        if (!string.IsNullOrWhiteSpace(Model.BuildingLetter))
        {
            string letter = Model.BuildingLetter.Trim().ToUpper();
            letter = letter.TrimStart('-', ' ');
            letter = letter.Replace("A", "А").Replace("B", "В").Replace("C", "С")
                           .Replace("E", "Е").Replace("H", "Н").Replace("I", "І")
                           .Replace("M", "М").Replace("O", "О").Replace("P", "Р")
                           .Replace("T", "Т").Replace("X", "Х");
            Model.BuildingLetter = letter;
        }

        if (Model.Lat == 0 && string.IsNullOrEmpty(Model.GeoJson))
        {
            osmMessage = "❌ Помилка: Оберіть розташування на карті (клікніть або знайдіть контур)!";
            return;
        }

        var response = Model.Id == 0
            ? await Http.PostAsJsonAsync("api/buildings", Model)
            : await Http.PutAsJsonAsync($"api/buildings/{Model.Id}", Model);

        if (response.IsSuccessStatusCode)
        {
            mapInitialized = false;
            await OnSaved.InvokeAsync();
        }
    }

    private async Task Close()
    {
        mapInitialized = false;
        await OnClosed.InvokeAsync();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}