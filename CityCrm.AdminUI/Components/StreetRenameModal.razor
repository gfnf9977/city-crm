@using CityCrm.AdminUI.Models
@inject HttpClient Http

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content border-warning">
                <div class="modal-header bg-warning bg-opacity-25">
                    <h5 class="modal-title"><i class="bi bi-signpost-split"></i> Офіційне перейменування</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-secondary py-2 mb-3">
                        Поточна назва: <strong>@Model.StreetType @Model.Name</strong>
                        <br/><small class="text-muted">Вона автоматично перенесеться в історію колишніх назв.</small>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Новий тип</label>
                            <select class="form-select" @bind="newType">
                                <option value="вул.">вул.</option>
                                <option value="просп.">просп.</option>
                                <option value="пров.">пров.</option>
                            </select>
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label fw-bold">Нова назва</label>
                            <input type="text" class="form-control" @bind="newName" placeholder="Напр: Незалежності" />
                        </div>
                    </div>
                    
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="text-danger small mb-3">@errorMessage</div>
                    }

                    <div class="d-flex justify-content-end mt-2">
                        <button type="button" class="btn btn-secondary me-2" @onclick="Close">Скасувати</button>
                        <button type="button" class="btn btn-warning" @onclick="Save">Перейменувати</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Street Model { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnClosed { get; set; }

    private string newType = "";
    private string newName = "";
    private string errorMessage = "";

    protected override void OnParametersSet()
    {
        if (IsVisible)
        {
            newType = Model.StreetType;
            newName = "";
            errorMessage = "";
        }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            errorMessage = "Введіть нову назву.";
            return;
        }

        var trimmedName = newName.Trim();
        
        if (char.IsLower(trimmedName[0]))
        {
            trimmedName = char.ToUpper(trimmedName[0]) + (trimmedName.Length > 1 ? trimmedName.Substring(1) : "");
        }

        var oldFullName = $"{Model.StreetType} {Model.Name}".Trim();
        var newFullName = $"{newType} {trimmedName}".Trim();

        var oldNamesList = string.IsNullOrWhiteSpace(Model.OldNames) 
            ? new List<string>() 
            : Model.OldNames.Split(',').Select(n => n.Trim()).ToList();

        if (!oldNamesList.Contains(oldFullName))
        {
            oldNamesList.Insert(0, oldFullName);
        }

        oldNamesList.RemoveAll(n => n.Equals(newFullName, StringComparison.OrdinalIgnoreCase));

        Model.OldNames = oldNamesList.Any() ? string.Join(", ", oldNamesList) : null;
        Model.StreetType = newType;
        Model.Name = trimmedName;

        var response = await Http.PutAsJsonAsync($"api/streets/{Model.Id}", Model);

        if (response.IsSuccessStatusCode)
            await OnSaved.InvokeAsync();
        else
            errorMessage = "Помилка збереження на сервері.";
    }

    private async Task Close() => await OnClosed.InvokeAsync();
}